<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Description>LaTeX math rendering plugin for WpfMarkdownViewer, powered by WpfMath.</Description>
    <PackageTags>$(PackageTags);latex;math</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WpfMath" Version="2.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WpfMarkdownViewer\WpfMarkdownViewer.csproj" />
  </ItemGroup>

</Project>

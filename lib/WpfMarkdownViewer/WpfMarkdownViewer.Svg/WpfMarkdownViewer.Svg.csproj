<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Description>SVG image rendering plugin for WpfMarkdownViewer, powered by SharpVectors.</Description>
    <PackageTags>$(PackageTags);svg;vector</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpVectors.Reloaded" Version="1.8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WpfMarkdownViewer\WpfMarkdownViewer.csproj" />
  </ItemGroup>

</Project>

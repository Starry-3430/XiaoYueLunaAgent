<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 弹窗卡片：窗口阴影与圆角交由 DWM 原生处理 -->
    <Style x:Key="DialogBorder" TargetType="Border">
        <Setter Property="Background" Value="#FAFAF0"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="24,20,24,16"/>
        <Setter Property="MinWidth" Value="320"/>
        <Setter Property="MaxWidth" Value="480"/>
    </Style>

    <!-- 大标题：左对齐、加粗、稍大 -->
    <Style x:Key="DialogTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#5B4833"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="TextAlignment" Value="Left"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- 正文：左对齐 -->
    <Style x:Key="DialogBody" TargetType="ContentPresenter">
        <Setter Property="TextElement.Foreground" Value="#5B4833"/>
        <Setter Property="TextElement.FontSize" Value="14"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Margin" Value="0,0,0,20"/>
    </Style>

</ResourceDictionary>
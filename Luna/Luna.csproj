<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <!-- API 目标：Windows 10 2004 (19041)；最低支持：Windows 10 1809 (17763) -->
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
        <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <RootNamespace>Luna</RootNamespace>
        <AssemblyName>Luna</AssemblyName>
    </PropertyGroup>

    <PropertyGroup>
        <ApplicationIcon>Assets\Luna.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
        <Resource Include="Assets\AlibabaPuHuiTi-3-105-Heavy.ttf" />
        <Resource Include="Assets\CascadiaMono.ttf" />
        <Resource Include="iconStream\icon.ico" />
        <Resource Include="iconStream\Luna.ico" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
      <PackageReference Include="ManagedCode.MarkItDown" Version="10.0.8" />
      <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
      <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
      <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12" />
      <PackageReference Include="NativeTray" Version="2.2.3" />
      <PackageReference Include="Serilog" Version="4.4.0" />
      <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
      <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
      <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
        <PackageReference Include="Dapper" Version="2.1.35" />
        <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
        <PackageReference Include="DynamicAero2" Version="1.3.0" />
        <PackageReference Include="System.Data.OleDb" Version="10.0.12" />
        <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
        <ProjectReference Include="..\lib\WpfMarkdownViewer\WpfMarkdownViewer.All\WpfMarkdownViewer.All.csproj" />
    </ItemGroup>

</Project>

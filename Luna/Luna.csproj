<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <!-- API 目标：Windows 10 2004 (19041)；最低支持：Windows 10 1809 (17763) -->
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
        <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <UseWindowsForms>true</UseWindowsForms>
        <RootNamespace>Luna</RootNamespace>
        <AssemblyName>Luna</AssemblyName>
    </PropertyGroup>

    <PropertyGroup>
        <ApplicationIcon>Assets\Luna.ico</ApplicationIcon>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <DebugType>none</DebugType>
        <DebugSymbols>false</DebugSymbols>
        <CopyDebugSymbolFilesFromPackages>false</CopyDebugSymbolFilesFromPackages>
        <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    </PropertyGroup>

    <ItemGroup>
        <!-- UseWindowsForms 会注入全局 using，和 WPF 类型大量冲突，这里移除，按需显式引用 -->
        <Using Remove="System.Drawing" />
        <Using Remove="System.Windows.Forms" />
    </ItemGroup>

    <ItemGroup>
        <Resource Include="Assets\Animations\idle\idle_sprite.png" />
        <Resource Include="Assets\CascadiaMono.ttf" />
        <Resource Include="Assets\icons\ChatUI\attachmentimport.png" />
        <Resource Include="Assets\icons\DiaryUI\failed.png" />
        <Resource Include="Assets\icons\DiaryUI\nodata.png" />
        <Resource Include="Assets\icons\DiaryUI\pending.png" />
        <Resource Include="Assets\icons\HomeUI\diary.PNG" />
        <Resource Include="Assets\icons\HomeUI\newsession.PNG" />
        <Resource Include="Assets\icons\HomeUI\settings.PNG" />
        <Resource Include="Assets\icons\HomeUI\tools.PNG" />
        <Resource Include="iconStream\icon.ico" />
        <Resource Include="iconStream\Luna.ico" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
      <PackageReference Include="ManagedCode.MarkItDown" Version="10.0.8" />
      <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
      <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
      <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12" />
      <PackageReference Include="NativeTray" Version="2.2.3" />
      <PackageReference Include="Serilog" Version="4.4.0" />
      <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
      <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
      <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
        <PackageReference Include="Dapper" Version="2.1.35" />
        <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
        <PackageReference Include="DynamicAero2" Version="1.3.0" />
        <PackageReference Include="System.Data.OleDb" Version="10.0.12" />
        <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
        <ProjectReference Include="..\lib\WpfMarkdownViewer\WpfMarkdownViewer.All\WpfMarkdownViewer.All.csproj" />
    </ItemGroup>

    <Target Name="RemoveDebugSymbolsFromPublish" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release'">
        <ItemGroup>
            <_PublishedPdb Include="$(PublishDir)**\*.pdb" />
        </ItemGroup>
        <Delete Files="@(_PublishedPdb)" ContinueOnError="true" />
    </Target>

</Project>

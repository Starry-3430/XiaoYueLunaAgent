<Window x:Class="Luna.Demo.BubbleDemoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BubbleTip 演示"
        Width="640"
        Height="460"
        MinWidth="420"
        MinHeight="300"
        WindowStartupLocation="CenterScreen"
        Background="#26221E">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="指针所在边："
                       Foreground="#EDE6D6"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <ComboBox x:Name="SideBox" Width="110" SelectedIndex="1">
                <ComboBoxItem Content="Top"/>
                <ComboBoxItem Content="Bottom"/>
                <ComboBoxItem Content="Left"/>
                <ComboBoxItem Content="Right"/>
            </ComboBox>
            <CheckBox x:Name="ShowBubbleBox"
                      Content="显示气泡"
                      IsChecked="True"
                      Foreground="#EDE6D6"
                      VerticalAlignment="Center"
                      Margin="18,0,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,16"
                Background="#3A342E"
                CornerRadius="10">
            <Button x:Name="AttachButton"
                    Content="导入附件"
                    Width="120"
                    Height="42"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#F6EEDC"
                    Foreground="#5A4A42"
                    BorderThickness="0"
                    FontSize="14">
                <Button.RenderTransform>
                    <TranslateTransform x:Name="ButtonOffset"/>
                </Button.RenderTransform>
            </Button>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <TextBlock Text="按钮水平偏移："
                       Foreground="#EDE6D6"
                       VerticalAlignment="Center"/>
            <Slider x:Name="OffsetSlider"
                    Width="220"
                    Minimum="-150"
                    Maximum="150"
                    Value="0"
                    VerticalAlignment="Center"/>
        </StackPanel>

        <TextBlock Grid.Row="3"
                   Margin="0,12,0,0"
                   Text="拖动窗口、缩放窗口或移动按钮，气泡尖端都会一直指向按钮。"
                   Foreground="#BDB3A2"
                   TextWrapping="Wrap"/>
    </Grid>
</Window>

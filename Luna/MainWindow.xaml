<Window x:Class="Luna.MainWindow"
        
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:Luna.Models"
        xmlns:md="clr-namespace:WpfMarkdownViewer.Controls;assembly=WpfMarkdownViewer"
        xmlns:converters="clr-namespace:Luna.Converters"
        Title="Luna"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Deactivated="Window_Deactivated"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:SubtractConverter x:Key="SubtractConverter"/>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="12"/>
            <Setter Property="MinWidth" Value="12"/>
            <Setter Property="Template" Value="{StaticResource Win11VerticalScrollBarLight}"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="12"/>
                    <Setter Property="MinHeight" Value="12"/>
                    <Setter Property="Template" Value="{StaticResource Win11HorizontalScrollBar}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 圆角输入框 -->
        <Style x:Key="RoundedTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Top"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- 红色取消按钮 -->
        <Style x:Key="CancelButton" TargetType="Button">
            <Setter Property="Background" Value="#FD7956"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#D64541"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#A93226"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- 圆角按钮 -->
        <Style x:Key="RoundedButton" TargetType="Button">
            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#4A4A4A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#5A5A5A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
    </Window.Resources>
    <Border x:Name="IslandBorder"
            Background="#362F2B"
            CornerRadius="25"
            Padding="12"
            MinWidth="280" MinHeight="50">
        <Grid>
            <Grid x:Name="CompactContent"
                  VerticalAlignment="Center">
                <TextBox x:Name="CompactInputBox"
                         Width="156" Height="30"
                         HorizontalAlignment="Left"
                         AcceptsReturn="True"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="White"
                         CaretBrush="White"
                         FontSize="13"
                         Padding="6,4"
                         VerticalContentAlignment="Center"
                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                         TextChanged="CompactInputBox_TextChanged"
                         PreviewKeyDown="CompactInputBox_KeyDown"/>
                <TextBlock x:Name="Placeholder"
                           Text="在此处键入内容"
                           Foreground="#66FFFFFF"
                           FontSize="13"
                           IsHitTestVisible="False"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"
                           Visibility="Visible"/>
            </Grid>

            <!-- 展开态：完整交互 -->
            <Grid x:Name="ExpandedContent"
                  Width="420" Height="840"
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题 -->
                <!-- <TextBlock Grid.Row="0" -->
                <!--            Text="" -->
                <!--            Foreground="White" -->
                <!--            FontSize="16" -->
                <!--            FontWeight="SemiBold" -->
                <!--            Margin="4,0,0,8"/> -->

                <!-- 消息区 -->
                <ScrollViewer x:Name="MessageScrollViewer"
                              Grid.Row="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.CanContentScroll="False"
                              PreviewMouseWheel="SmoothScroll_PreviewMouseWheel">
                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
<Border Margin="0,0,0,6" Padding="0"
                                        CornerRadius="6">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="HorizontalAlignment" Value="Left"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Role}" Value="user">
                                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                                    <Setter Property="Background" Value="#E4E0CA"/>
                                                    <Setter Property="MaxWidth" Value="500"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <!-- 用户消息：纯文本 -->
                                        <TextBox Text="{Binding Content}"
                                                   TextWrapping="Wrap"
                                                   Foreground="#5B4833"
                                                   FontSize="15"
                                                   HorizontalAlignment="Left"
                                                   Margin="8,4"
                                                   IsReadOnly="True"
                                                   BorderThickness="0"
                                                   Background="Transparent"
                                                   IsInactiveSelectionHighlightEnabled="True"
                                                   Loaded="MessageText_Loaded">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Role}" Value="user">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
<!-- AI 消息：Markdown 阅读器 + 思考指示 + 操作按钮 -->
<StackPanel>
                                                <!-- 思考指示 / 思考内容（在 Markdown 上方） -->
                                                <StackPanel Margin="8,4,8,0">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Role}" Value="assistant">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>

                                                    <!-- 无推理内容时：动画 "正在思考..." -->
                                                    <StackPanel Orientation="Horizontal"
                                                                IsHitTestVisible="False">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasReasoning}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsThinking}" Value="False">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <TextBlock Text="正在思考" Foreground="#88FFFFFF" FontSize="15" FontStyle="Italic" VerticalAlignment="Center"/>
                                                        <TextBlock Text="." Foreground="#88FFFFFF" FontSize="15" VerticalAlignment="Center" Margin="1,0,0,0">
                                                            <TextBlock.Triggers>
                                                                <EventTrigger RoutedEvent="Loaded">
                                                                    <BeginStoryboard>
                                                                        <Storyboard RepeatBehavior="Forever">
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.2" To="1" Duration="0:0:0.6" AutoReverse="True" BeginTime="0:0:0.0"/>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </EventTrigger>
                                                            </TextBlock.Triggers>
                                                        </TextBlock>
                                                        <TextBlock Text="." Foreground="#88FFFFFF" FontSize="15" VerticalAlignment="Center" Margin="0">
                                                            <TextBlock.Triggers>
                                                                <EventTrigger RoutedEvent="Loaded">
                                                                    <BeginStoryboard>
                                                                        <Storyboard RepeatBehavior="Forever">
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.2" To="1" Duration="0:0:0.6" AutoReverse="True" BeginTime="0:0:0.2"/>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </EventTrigger>
                                                            </TextBlock.Triggers>
                                                        </TextBlock>
                                                        <TextBlock Text="." Foreground="#88FFFFFF" FontSize="15" VerticalAlignment="Center" Margin="0">
                                                            <TextBlock.Triggers>
                                                                <EventTrigger RoutedEvent="Loaded">
                                                                    <BeginStoryboard>
                                                                        <Storyboard RepeatBehavior="Forever">
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.2" To="1" Duration="0:0:0.6" AutoReverse="True" BeginTime="0:0:0.4"/>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </EventTrigger>
                                                            </TextBlock.Triggers>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <!-- 有推理内容时：可折叠思考过程 -->
                                                    <StackPanel>
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasReasoning}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <ToggleButton IsChecked="{Binding IsReasoningExpanded, Mode=TwoWay}"
                                                                      HorizontalAlignment="Left" Cursor="Hand"
                                                                      Background="Transparent" BorderThickness="0"
                                                                      Padding="0" Margin="0,0,0,4">
                                                            <ToggleButton.Template>
                                                                <ControlTemplate TargetType="ToggleButton">
                                                                    <Border Background="Transparent" Padding="8,4">
                                                                        <ContentPresenter/>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </ToggleButton.Template>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="思考过程" Foreground="#88FFFFFF" FontSize="13" FontStyle="Italic" VerticalAlignment="Center"/>
                                                                <TextBlock Text="▸" Foreground="#88FFFFFF" FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsReasoningExpanded}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock Text="▾" Foreground="#88FFFFFF" FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsReasoningExpanded}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </ToggleButton>
                                                        <!-- 用户收起但仍在思考中 -->
                                                        <StackPanel Orientation="Horizontal"
                                                                    IsHitTestVisible="False" Margin="0,0,0,4">
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding HasReasoning}" Value="True"/>
                                                                                <Condition Binding="{Binding IsReasoningExpanded}" Value="False"/>
                                                                                <Condition Binding="{Binding IsThinking}" Value="True"/>
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>
                                                            <TextBlock Text="正在思考" Foreground="#88FFFFFF" FontSize="13" FontStyle="Italic" VerticalAlignment="Center"/>
                                                            <TextBlock Text="." Foreground="#88FFFFFF" FontSize="13" VerticalAlignment="Center" Margin="1,0,0,0">
                                                                <TextBlock.Triggers>
                                                                    <EventTrigger RoutedEvent="Loaded">
                                                                        <BeginStoryboard>
                                                                            <Storyboard RepeatBehavior="Forever">
                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.2" To="1" Duration="0:0:0.6" AutoReverse="True" BeginTime="0:0:0.0"/>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </EventTrigger>
                                                                </TextBlock.Triggers>
                                                            </TextBlock>
                                                            <TextBlock Text="." Foreground="#88FFFFFF" FontSize="13" VerticalAlignment="Center" Margin="0">
                                                                <TextBlock.Triggers>
                                                                    <EventTrigger RoutedEvent="Loaded">
                                                                        <BeginStoryboard>
                                                                            <Storyboard RepeatBehavior="Forever">
                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.2" To="1" Duration="0:0:0.6" AutoReverse="True" BeginTime="0:0:0.2"/>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </EventTrigger>
                                                                </TextBlock.Triggers>
                                                            </TextBlock>
                                                            <TextBlock Text="." Foreground="#88FFFFFF" FontSize="13" VerticalAlignment="Center" Margin="0">
                                                                <TextBlock.Triggers>
                                                                    <EventTrigger RoutedEvent="Loaded">
                                                                        <BeginStoryboard>
                                                                            <Storyboard RepeatBehavior="Forever">
                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.2" To="1" Duration="0:0:0.6" AutoReverse="True" BeginTime="0:0:0.4"/>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </EventTrigger>
                                                                </TextBlock.Triggers>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto"
                                                                      Loaded="ReasoningScrollViewer_Loaded"
                                                                      Visibility="{Binding IsReasoningExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="{Binding Reasoning}" TextWrapping="Wrap"
                                                                       Foreground="#CCE4E0CA" FontSize="13"
                                                                       IsHitTestVisible="False" Focusable="False"/>
                                                        </ScrollViewer>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- 工具调用卡片 -->
                                                <ItemsControl ItemsSource="{Binding ToolCalls}" Margin="8,4,8,0">
                                                    <ItemsControl.Style>
                                                        <Style TargetType="ItemsControl">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding HasToolCalls}" Value="True"/>
                                                                        <Condition Binding="{Binding Role}" Value="assistant"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ItemsControl.Style>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type models:ToolCallEntry}">
                                                            <StackPanel Margin="0,0,0,0">
                                                                <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                                              HorizontalAlignment="Left" Cursor="Hand"
                                                                              Background="Transparent" BorderThickness="0"
                                                                              Padding="0">
                                                                    <ToggleButton.Template>
                                                                        <ControlTemplate TargetType="ToggleButton">
                                                                            <Border Background="Transparent" Padding="8,4">
                                                                                <ContentPresenter/>
                                                                            </Border>
                                                                        </ControlTemplate>
                                                                    </ToggleButton.Template>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Foreground="#88FFFFFF" FontSize="10" VerticalAlignment="Center">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding Status}" Value="Pending">  <Setter Property="Text" Value="⏳"/></DataTrigger>
                                                                                        <DataTrigger Binding="{Binding Status}" Value="Running"> <Setter Property="Text" Value="⏳"/></DataTrigger>
                                                                                        <DataTrigger Binding="{Binding Status}" Value="Success"> <Setter Property="Text" Value="✓"/></DataTrigger>
                                                                                        <DataTrigger Binding="{Binding Status}" Value="Failed">  <Setter Property="Text" Value="✗"/></DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                        <TextBlock Text="{Binding DisplayName}" Foreground="#CCE4E0CA" FontSize="13" FontStyle="Italic" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                                        <TextBlock Text="▸" Foreground="#88FFFFFF" FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                        <TextBlock Text="▾" Foreground="#88FFFFFF" FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                </ToggleButton>
                                                                <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                            Margin="0,4,0,0">
                                                                    <TextBlock Text="参数" Foreground="#88FFFFFF" FontSize="11" FontStyle="Italic" Margin="8,0,0,2"/>
                                                                    <ScrollViewer MaxHeight="90" VerticalScrollBarVisibility="Auto" Margin="0,0,0,4">
                                                                        <TextBlock Text="{Binding ArgumentsJson}" Foreground="#88FFFFFF" FontSize="11"
                                                                                   FontFamily="Consolas" TextWrapping="Wrap" Margin="8,0,0,0"/>
                                                                    </ScrollViewer>
                                                                    <TextBlock Text="结果" Foreground="#88FFFFFF" FontSize="11" FontStyle="Italic" Margin="8,0,0,2"/>
                                                                    <ScrollViewer MaxHeight="90" VerticalScrollBarVisibility="Auto">
                                                                        <TextBlock Text="{Binding ResultJson}" Foreground="#CCE4E0CA" FontSize="13"
                                                                                   TextWrapping="Wrap" Margin="8,0,0,0"/>
                                                                    </ScrollViewer>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                            <md:MarkdownDocumentView SelectionEnabled="True"
                                                                                Background="Transparent"
                                                                                HorizontalAlignment="Left"
                                                                                VirtualizationEnabled="False"
                                                                                MaxWidth="520"
                                                                                Loaded="MessageViewer_Loaded"
                                                                                PreviewMouseWheel="MarkdownViewer_PreviewMouseWheel">
                                                    <md:MarkdownDocumentView.Style>
                                                        <Style TargetType="md:MarkdownDocumentView">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding Role}" Value="assistant"/>
                                                                        <Condition Binding="{Binding HasContent}" Value="True"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </md:MarkdownDocumentView.Style>
                                                </md:MarkdownDocumentView>
                                                <!-- 出错 / 取消提示 -->
                                                <Border Margin="8,4,8,0" Padding="10,7" CornerRadius="6"
                                                        Background="#33FD7956"
                                                        HorizontalAlignment="Left"
                                                        Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFB4A0"
                                                               FontSize="13" TextWrapping="Wrap" MaxWidth="500"/>
                                                </Border>
                                                <StackPanel Orientation="Horizontal" Margin="8,0,0,4">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Role}" Value="assistant"/>
                                                                    <Condition Binding="{Binding IsFinalReply}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <Button Content="复制" FontSize="12" Height="26" Width="50"
                                                        Cursor="Hand" BorderThickness="0" Foreground="#88FFFFFF"
                                                        Background="#333333" Margin="0,0,6,0"
                                                        Click="CopyMessage_Click"/>
                                                <Button Content="重写" FontSize="12" Height="26" Width="50"
                                                        Cursor="Hand" BorderThickness="0" Foreground="#88FFFFFF"
                                                        Background="#333333"
                                                        Click="RewriteMessage_Click"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 输入区 -->
                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="InputBox"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             MaxHeight="66"
                             Grid.Column="0"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto"
                             Style="{StaticResource RoundedTextBox}"
                             Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                             Background="#22FFFFFF"
                             Padding="8,6"
                             PreviewKeyDown="InputBox_KeyDown"/>

                    <Button Grid.Column="1"
                            Content="发送"
                            Command="{Binding SendCommand}"
                            VerticalAlignment="Bottom"
                            Margin="6,0,0,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource RoundedButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Grid.Column="1"
                            Content="取消"
                            Style="{StaticResource CancelButton}"
                            Command="{Binding CancelCommand}"
                            VerticalAlignment="Bottom"
                            Margin="6,0,0,0"
                            Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    
                </Grid>

                <!-- 状态 -->
                <TextBlock Grid.Row="2"
                           Text="{Binding Status}"
                           Foreground="#88FFFFFF"
                           FontSize="11"
                           Margin="4,6,0,0"/>
            </Grid>
        </Grid>
    </Border>
</Window>


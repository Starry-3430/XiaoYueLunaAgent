<Window x:Class="Luna.MainWindow"
        
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:Luna.Models"
        xmlns:loc="clr-namespace:Luna.Localization"
        xmlns:md="clr-namespace:WpfMarkdownViewer.Controls;assembly=WpfMarkdownViewer"
        xmlns:converters="clr-namespace:Luna.Converters"
        xmlns:controls="clr-namespace:Luna.Controls"
        Title="Luna"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Deactivated="Window_Deactivated"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:SubtractConverter x:Key="SubtractConverter"/>
        <converters:FileSizeConverter x:Key="FileSizeConverter"/>
        <converters:AttachmentMetaConverter x:Key="AttachmentMetaConverter"/>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="12"/>
            <Setter Property="MinWidth" Value="12"/>
            <Setter Property="Template" Value="{StaticResource Win11VerticalScrollBarLight}"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="12"/>
                    <Setter Property="MinHeight" Value="12"/>
                    <Setter Property="Template" Value="{StaticResource Win11HorizontalScrollBar}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 圆角输入框 -->
        <Style x:Key="RoundedTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Top"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- 红色取消按钮 -->
        <Style x:Key="CancelButton" TargetType="Button">
            <Setter Property="Background" Value="#FD7956"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#D64541"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#A93226"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- 圆角按钮 -->
        <Style x:Key="RoundedButton" TargetType="Button">
            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#4A4A4A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#5A5A5A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Opacity" Value="0.85"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bg" Property="Opacity" Value="0.7"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RemoveChipButton" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#88FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="9" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#26FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 聊天操作图标（Assets/icons/ChatUI，24 坐标系描边路径） -->
        <PathGeometry x:Key="IconCopy" Figures="M9 2 H15 A1 1 0 0 1 16 3 V5 A1 1 0 0 1 15 6 H9 A1 1 0 0 1 8 5 V3 A1 1 0 0 1 9 2 Z M16 4 H18 A2 2 0 0 1 20 6 V20 A2 2 0 0 1 18 22 H6 A2 2 0 0 1 4 20 V6 A2 2 0 0 1 6 4 H8"/>
        <PathGeometry x:Key="IconRegenerate" Figures="M3 12 A9 9 0 1 0 12 3 A9.75 9.75 0 0 0 5.26 5.74 L3 8 M3 3 V8 H8"/>
        <PathGeometry x:Key="IconChevronDown" Figures="M6 9 L12 15 L18 9"/>
        <PathGeometry x:Key="IconAttachment" Figures="M10 13 a5 5 0 0 0 7.54 .54 l3 -3 a5 5 0 0 0 -7.07 -7.07 l-1.72 1.71 M14 11 a5 5 0 0 0 -7.54 -.54 l-3 3 a5 5 0 0 0 7.07 7.07 l1.71 -1.71"/>

        <Style x:Key="LineIconGlyph" TargetType="Path">
            <Setter Property="Stroke" Value="#88FFFFFF"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Fill" Value="Transparent"/>
        </Style>

        <!-- 附件图标：描边颜色跟随所在按钮的 Foreground -->
        <Style x:Key="AttachmentIconGlyph" TargetType="Path" BasedOn="{StaticResource LineIconGlyph}">
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        </Style>

        <!-- 聊天消息操作按钮：正方形圆角，默认无背景，悬停才出现浅色底 -->
        <Style x:Key="ChatActionButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#26FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3DFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
    </Window.Resources>
    <Border x:Name="IslandBorder"
            Background="#362F2B"
            CornerRadius="25"
            Padding="12"
            MinWidth="280" MinHeight="50">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid x:Name="CompactContent"
                  Grid.Row="0"
                  VerticalAlignment="Center">
                <TextBox x:Name="CompactInputBox"
                         Width="156" Height="30"
                         HorizontalAlignment="Left"
                         AcceptsReturn="True"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="White"
                         CaretBrush="White"
                         FontSize="13"
                         Padding="6,4"
                         VerticalContentAlignment="Center"
                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                         TextChanged="CompactInputBox_TextChanged"
                         PreviewKeyDown="CompactInputBox_KeyDown"/>
                <TextBlock x:Name="Placeholder"
                           Text="{loc:Loc Main_Placeholder}"
                           Foreground="#66FFFFFF"
                           FontSize="13"
                           IsHitTestVisible="False"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"
                           Visibility="Visible"/>
            </Grid>

            <!-- 胶囊悬停展开区：左侧计数；右侧“添加附件”与“全部删除”（导入后两者并存） -->
            <Grid x:Name="CapsuleAttachmentPanel"
                  Grid.Row="1"
                  Height="0" Opacity="0"
                  ClipToBounds="True"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Bottom">
                <TextBlock x:Name="CapsuleAttachmentCount"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Margin="4,4,0,0"
                           Foreground="#CCE4E0CA" FontSize="12"/>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,4,0,0">
                    <Button x:Name="CapsuleAttachButton"
                            Style="{StaticResource ChatActionButton}"
                            Foreground="White"
                            ToolTip="{loc:Loc Common_AddAttachment}"
                            Click="AttachFile_Click">
                        <Viewbox Width="15" Height="15">
                            <Canvas Width="24" Height="24">
                                <Path Style="{StaticResource AttachmentIconGlyph}"
                                      Data="{StaticResource IconAttachment}"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button x:Name="CapsuleClearButton"
                            Content="{loc:Loc Main_ClearAttachments}"
                            Height="28" Padding="12,0" Margin="6,0,0,0"
                            FontSize="12"
                            Visibility="Collapsed"
                            Style="{StaticResource PillButton}"
                            Foreground="White" Background="#5A4A42"
                            Command="{Binding ClearAttachmentsCommand}"/>
                </StackPanel>
            </Grid>

            <!-- 展开态：完整交互 -->
            <Grid x:Name="ExpandedContent"
                  Grid.RowSpan="2"
                  Width="420" Height="840"
                  Visibility="Collapsed"
                  AllowDrop="True"
                  DragEnter="ExpandedContent_DragEnter"
                  DragOver="ExpandedContent_DragOver"
                  DragLeave="ExpandedContent_DragLeave"
                  Drop="ExpandedContent_Drop">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题 -->
                <!-- <TextBlock Grid.Row="0" -->
                <!--            Text="" -->
                <!--            Foreground="White" -->
                <!--            FontSize="16" -->
                <!--            FontWeight="SemiBold" -->
                <!--            Margin="4,0,0,8"/> -->

                <!-- 消息区 -->
                <ScrollViewer x:Name="MessageScrollViewer"
                              Grid.Row="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.CanContentScroll="False"
                              PreviewMouseWheel="SmoothScroll_PreviewMouseWheel">
                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Visibility"
                                        Value="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
<Border Margin="0,0,0,6" Padding="0"
                                        CornerRadius="6">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="HorizontalAlignment" Value="Left"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Role}" Value="user">
                                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                                    <Setter Property="Background" Value="#E4E0CA"/>
                                                    <Setter Property="MaxWidth" Value="500"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Role}" Value="system">
                                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <!-- 用户消息：纯文本 -->
                                        <TextBox Text="{Binding Content}"
                                                   TextWrapping="Wrap"
                                                   Foreground="#5B4833"
                                                   FontSize="15"
                                                   HorizontalAlignment="Left"
                                                   Margin="8,4"
                                                   IsReadOnly="True"
                                                   BorderThickness="0"
                                                   Background="Transparent"
                                                   IsInactiveSelectionHighlightEnabled="True"
                                                   controls:EditorContextMenu.IsExcluded="True"
                                                   Loaded="MessageText_Loaded">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Role}" Value="user">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
<!-- AI 消息：Markdown 阅读器 + 思考指示 + 操作按钮 -->
<StackPanel>
                                                <!-- 思考指示 / 思考内容（在 Markdown 上方） -->
                                                <StackPanel Margin="8,4,8,0">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Role}" Value="assistant">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>

                                                    <!-- 无推理内容时：动画 "正在思考..." -->
                                                    <StackPanel Orientation="Horizontal"
                                                                IsHitTestVisible="False">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasReasoning}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsThinking}" Value="False">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <TextBlock Text="{loc:Loc Common_Thinking}" Foreground="#88FFFFFF" FontSize="15" FontStyle="Italic" VerticalAlignment="Center"/>
                                                        <TextBlock Text="." Foreground="#88FFFFFF" FontSize="15" VerticalAlignment="Center" Margin="1,0,0,0">
                                                            <TextBlock.Triggers>
                                                                <EventTrigger RoutedEvent="Loaded">
                                                                    <BeginStoryboard>
                                                                        <Storyboard RepeatBehavior="Forever">
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.2" To="1" Duration="0:0:0.6" AutoReverse="True" BeginTime="0:0:0.0"/>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </EventTrigger>
                                                            </TextBlock.Triggers>
                                                        </TextBlock>
                                                        <TextBlock Text="." Foreground="#88FFFFFF" FontSize="15" VerticalAlignment="Center" Margin="0">
                                                            <TextBlock.Triggers>
                                                                <EventTrigger RoutedEvent="Loaded">
                                                                    <BeginStoryboard>
                                                                        <Storyboard RepeatBehavior="Forever">
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.2" To="1" Duration="0:0:0.6" AutoReverse="True" BeginTime="0:0:0.2"/>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </EventTrigger>
                                                            </TextBlock.Triggers>
                                                        </TextBlock>
                                                        <TextBlock Text="." Foreground="#88FFFFFF" FontSize="15" VerticalAlignment="Center" Margin="0">
                                                            <TextBlock.Triggers>
                                                                <EventTrigger RoutedEvent="Loaded">
                                                                    <BeginStoryboard>
                                                                        <Storyboard RepeatBehavior="Forever">
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.2" To="1" Duration="0:0:0.6" AutoReverse="True" BeginTime="0:0:0.4"/>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </EventTrigger>
                                                            </TextBlock.Triggers>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <!-- 有推理内容时：可折叠思考过程 -->
                                                    <StackPanel>
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasReasoning}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <ToggleButton IsChecked="{Binding IsReasoningExpanded, Mode=TwoWay}"
                                                                      HorizontalAlignment="Left" Cursor="Hand"
                                                                      Background="Transparent" BorderThickness="0"
                                                                      Padding="0" Margin="0,0,0,4">
                                                            <ToggleButton.Template>
                                                                <ControlTemplate TargetType="ToggleButton">
                                                                    <Border Background="Transparent" Padding="8,4">
                                                                        <ContentPresenter/>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </ToggleButton.Template>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{loc:Loc Common_ReasoningProcess}" Foreground="#88FFFFFF" FontSize="13" FontStyle="Italic" VerticalAlignment="Center"/>
                                                                <TextBlock Text="▸" Foreground="#88FFFFFF" FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsReasoningExpanded}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock Text="▾" Foreground="#88FFFFFF" FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsReasoningExpanded}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </ToggleButton>
                                                        <!-- 用户收起但仍在思考中 -->
                                                        <StackPanel Orientation="Horizontal"
                                                                    IsHitTestVisible="False" Margin="0,0,0,4">
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding HasReasoning}" Value="True"/>
                                                                                <Condition Binding="{Binding IsReasoningExpanded}" Value="False"/>
                                                                                <Condition Binding="{Binding IsThinking}" Value="True"/>
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>
                                                            <TextBlock Text="{loc:Loc Common_Thinking}" Foreground="#88FFFFFF" FontSize="13" FontStyle="Italic" VerticalAlignment="Center"/>
                                                            <TextBlock Text="." Foreground="#88FFFFFF" FontSize="13" VerticalAlignment="Center" Margin="1,0,0,0">
                                                                <TextBlock.Triggers>
                                                                    <EventTrigger RoutedEvent="Loaded">
                                                                        <BeginStoryboard>
                                                                            <Storyboard RepeatBehavior="Forever">
                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.2" To="1" Duration="0:0:0.6" AutoReverse="True" BeginTime="0:0:0.0"/>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </EventTrigger>
                                                                </TextBlock.Triggers>
                                                            </TextBlock>
                                                            <TextBlock Text="." Foreground="#88FFFFFF" FontSize="13" VerticalAlignment="Center" Margin="0">
                                                                <TextBlock.Triggers>
                                                                    <EventTrigger RoutedEvent="Loaded">
                                                                        <BeginStoryboard>
                                                                            <Storyboard RepeatBehavior="Forever">
                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.2" To="1" Duration="0:0:0.6" AutoReverse="True" BeginTime="0:0:0.2"/>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </EventTrigger>
                                                                </TextBlock.Triggers>
                                                            </TextBlock>
                                                            <TextBlock Text="." Foreground="#88FFFFFF" FontSize="13" VerticalAlignment="Center" Margin="0">
                                                                <TextBlock.Triggers>
                                                                    <EventTrigger RoutedEvent="Loaded">
                                                                        <BeginStoryboard>
                                                                            <Storyboard RepeatBehavior="Forever">
                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.2" To="1" Duration="0:0:0.6" AutoReverse="True" BeginTime="0:0:0.4"/>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </EventTrigger>
                                                                </TextBlock.Triggers>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto"
                                                                      VerticalAlignment="Top"
                                                                      Loaded="ReasoningScrollViewer_Loaded"
                                                                      Visibility="{Binding IsReasoningExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="{Binding Reasoning}" TextWrapping="Wrap"
                                                                       Foreground="#CCE4E0CA" FontSize="13"
                                                                       IsHitTestVisible="False" Focusable="False"/>
                                                        </ScrollViewer>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- 工具调用卡片 -->
                                                <ItemsControl ItemsSource="{Binding ToolCalls}" Margin="8,4,8,0">
                                                    <ItemsControl.Style>
                                                        <Style TargetType="ItemsControl">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding HasToolCalls}" Value="True"/>
                                                                        <Condition Binding="{Binding Role}" Value="assistant"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ItemsControl.Style>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type models:ToolCallEntry}">
                                                            <StackPanel Margin="0,0,0,0">
                                                                <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                                              HorizontalAlignment="Left" Cursor="Hand"
                                                                              Background="Transparent" BorderThickness="0"
                                                                              Padding="0">
                                                                    <ToggleButton.Template>
                                                                        <ControlTemplate TargetType="ToggleButton">
                                                                            <Border Background="Transparent" Padding="8,4">
                                                                                <ContentPresenter/>
                                                                            </Border>
                                                                        </ControlTemplate>
                                                                    </ToggleButton.Template>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Foreground="#88FFFFFF" FontSize="10" VerticalAlignment="Center">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding Status}" Value="Pending">  <Setter Property="Text" Value="⏳"/></DataTrigger>
                                                                                        <DataTrigger Binding="{Binding Status}" Value="Running"> <Setter Property="Text" Value="⏳"/></DataTrigger>
                                                                                        <DataTrigger Binding="{Binding Status}" Value="Success"> <Setter Property="Text" Value="✓"/></DataTrigger>
                                                                                        <DataTrigger Binding="{Binding Status}" Value="Failed">  <Setter Property="Text" Value="✗"/></DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                        <TextBlock Text="{Binding DisplayName}" Foreground="#CCE4E0CA" FontSize="13" FontStyle="Italic" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                                        <TextBlock Text="▸" Foreground="#88FFFFFF" FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                        <TextBlock Text="▾" Foreground="#88FFFFFF" FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                </ToggleButton>
                                                                <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                            Margin="0,4,0,0">
                                                                    <TextBlock Text="{loc:Loc Common_Params}" Foreground="#88FFFFFF" FontSize="11" FontStyle="Italic" Margin="8,0,0,2"/>
                                                                    <ScrollViewer MaxHeight="90" VerticalScrollBarVisibility="Auto" Margin="0,0,0,4">
                                                                        <TextBlock Text="{Binding ArgumentsDisplay}" Foreground="#88FFFFFF" FontSize="11"
                                                                                   FontFamily="Consolas" TextWrapping="Wrap" Margin="8,0,0,0"/>
                                                                    </ScrollViewer>
                                                                    <TextBlock Text="{loc:Loc Common_Result}" Foreground="#88FFFFFF" FontSize="11" FontStyle="Italic" Margin="8,0,0,2"/>
                                                                    <ScrollViewer MaxHeight="90" VerticalScrollBarVisibility="Auto">
                                                                        <TextBlock Text="{Binding ResultJson}" Foreground="#CCE4E0CA" FontSize="13"
                                                                                   TextWrapping="Wrap" Margin="8,0,0,0"/>
                                                                    </ScrollViewer>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                            <md:MarkdownDocumentView SelectionEnabled="True"
                                                                                Background="Transparent"
                                                                                HorizontalAlignment="Left"
                                                                                VirtualizationEnabled="False"
                                                                                MaxWidth="520"
                                                                                Loaded="MessageViewer_Loaded"
                                                                                PreviewMouseWheel="MarkdownViewer_PreviewMouseWheel">
                                                    <md:MarkdownDocumentView.Style>
                                                        <Style TargetType="md:MarkdownDocumentView">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding Role}" Value="assistant"/>
                                                                        <Condition Binding="{Binding HasContent}" Value="True"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </md:MarkdownDocumentView.Style>
                                                </md:MarkdownDocumentView>
                                                <!-- 出错 / 取消提示 -->
                                                <Border Margin="8,4,8,10" Padding="10,7" CornerRadius="6"
                                                        Background="#33FD7956"
                                                        HorizontalAlignment="Left"
                                                        Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFB4A0"
                                                               FontSize="13" TextWrapping="Wrap" MaxWidth="500"/>
                                                </Border>
                                                <StackPanel Orientation="Horizontal" Margin="8,0,0,4">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Role}" Value="assistant"/>
                                                                    <Condition Binding="{Binding IsFinalReply}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <Button Style="{StaticResource ChatActionButton}"
                                                        Margin="0,0,6,0" ToolTip="{loc:Loc Common_Copy}"
                                                        Click="CopyMessage_Click">
                                                    <Viewbox Width="15" Height="15">
                                                        <Canvas Width="24" Height="24">
                                                            <Path Style="{StaticResource LineIconGlyph}" Data="{StaticResource IconCopy}"/>
                                                        </Canvas>
                                                    </Viewbox>
                                                </Button>
                                                <Button Style="{StaticResource ChatActionButton}"
                                                        ToolTip="{loc:Loc Common_Rewrite}"
                                                        Click="RewriteMessage_Click"
                                                        Visibility="{Binding CanRewrite, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Viewbox Width="15" Height="15">
                                                        <Canvas Width="24" Height="24">
                                                            <Path Style="{StaticResource LineIconGlyph}" Data="{StaticResource IconRegenerate}"/>
                                                        </Canvas>
                                                    </Viewbox>
                                                </Button>

                                                <!-- 版本切换：同一提问存在多个回复时显示 -->
                                                <StackPanel Orientation="Horizontal" Margin="6,0,0,0"
                                                            Visibility="{Binding HasMultipleVersions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Button Content="◀" Width="20" Height="20"
                                                            Foreground="#E4E0CA"
                                                            Style="{StaticResource ChatActionButton}"
                                                            ToolTip="{loc:Loc Common_PreviousVersion}"
                                                            Command="{Binding DataContext.SwitchToPrevVersionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                    <TextBlock Text="{Binding VersionText}" VerticalAlignment="Center"
                                                               Margin="4,0" FontSize="11" Foreground="#CCE4E0CA"/>
                                                    <Button Content="▶" Width="20" Height="20"
                                                            Foreground="#E4E0CA"
                                                            Style="{StaticResource ChatActionButton}"
                                                            ToolTip="{loc:Loc Common_NextVersion}"
                                                            Command="{Binding DataContext.SwitchToNextVersionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- 附件详情（system 消息）：仅显示“文件名 · 大小”，紧跟用户气泡下方 -->
                                        <TextBlock Margin="8,0,8,8"
                                                   HorizontalAlignment="Right"
                                                   TextAlignment="Right"
                                                   TextWrapping="Wrap"
                                                   MaxWidth="500"
                                                   Foreground="#88FFFFFF"
                                                   FontSize="11"
                                                   Text="{Binding AttachmentSummary}"
                                                   Visibility="{Binding HasAttachmentSummary, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 滚动到底部按钮：不在底部时显示，点击回到最新内容 -->
                <Button x:Name="ScrollToBottomButton"
                        Grid.Row="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,14"
                        Width="34" Height="34"
                        Visibility="Collapsed"
                        Cursor="Hand"
                        ToolTip="{loc:Loc Common_ScrollToBottom}"
                        Click="ScrollToBottom_Click"
                        PreviewMouseWheel="ScrollToBottomButton_PreviewMouseWheel">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Ellipse x:Name="Bg" Fill="#4A4A4A">
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="2"
                                                          Direction="270" Opacity="0.5"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                                <Viewbox Width="17" Height="17">
                                    <Canvas Width="24" Height="24">
                                        <Path Style="{StaticResource LineIconGlyph}" Data="{StaticResource IconChevronDown}"/>
                                    </Canvas>
                                </Viewbox>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Fill" Value="#5A5A5A"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bg" Property="Fill" Value="#6A6A6A"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- 待发送附件列表 -->
                <ItemsControl Grid.Row="1" ItemsSource="{Binding PendingAttachments}" Margin="0,6,0,0">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PendingAttachments.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:Attachment}">
                            <Border Background="#33FFFFFF" CornerRadius="8" Padding="8,4" Margin="0,0,6,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding FileName}"
                                               VerticalAlignment="Center"
                                               Foreground="#E4E0CA" FontSize="12"
                                               MaxWidth="200" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock VerticalAlignment="Center"
                                               Foreground="#88FFFFFF" FontSize="11" Margin="4,0,0,0">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource AttachmentMetaConverter}">
                                                <Binding Path="FileSize"/>
                                                <Binding Path="TokenEstimate"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <Button Content="✕" Width="18" Height="18" Margin="6,0,0,0"
                                            Style="{StaticResource RemoveChipButton}"
                                            FontSize="11"
                                            Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 输入区 -->
                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="InputBox"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             MaxHeight="66"
                             Grid.Column="0"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto"
                             Style="{StaticResource RoundedTextBox}"
                             Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                             Background="#22FFFFFF"
                             Padding="8,6"
                             PreviewKeyDown="InputBox_KeyDown"/>

                    <Button Grid.Column="1"
                            Content="{loc:Loc Common_Send}"
                            Command="{Binding SendCommand}"
                            VerticalAlignment="Bottom"
                            Margin="6,0,0,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource RoundedButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Grid.Column="1"
                            Content="{loc:Loc Common_Cancel}"
                            Style="{StaticResource CancelButton}"
                            Command="{Binding CancelCommand}"
                            VerticalAlignment="Bottom"
                            Margin="6,0,0,0"
                            Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    
                </Grid>

                <!-- 状态 -->
                <Grid Grid.Row="3" Margin="4,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding Status}"
                               Foreground="#88FFFFFF"
                               FontSize="11"
                               VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0"
                                Visibility="{Binding IsLoadingAttachments, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ProgressBar IsIndeterminate="True" Width="80" Height="5" VerticalAlignment="Center"
                                     Foreground="#88FFFFFF" Background="#33FFFFFF" BorderThickness="0"/>
                        <Button Content="{loc:Loc Common_Cancel}" Margin="6,0,0,0" Height="26" Padding="12,0"
                                FontSize="12" Style="{StaticResource PillButton}"
                                Foreground="#88FFFFFF" Background="#33FFFFFF"
                                Command="{Binding CancelAttachmentLoadCommand}"/>
                    </StackPanel>
                    <Button Grid.Column="2"
                            Style="{StaticResource ChatActionButton}"
                            Foreground="#88FFFFFF"
                            ToolTip="{loc:Loc Common_AddAttachment}"
                            VerticalAlignment="Center"
                            Click="AttachFile_Click">
                        <Viewbox Width="14" Height="14">
                            <Canvas Width="24" Height="24">
                                <Path Style="{StaticResource AttachmentIconGlyph}"
                                      Data="{StaticResource IconAttachment}"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                </Grid>
            </Grid>

            <!-- 提醒模式 -->
            <Grid x:Name="ReminderContent" Grid.RowSpan="2" Width="320" Visibility="Collapsed">
                <StackPanel Margin="14,12,14,10">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="⏰" FontSize="15" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc Main_Reminder}" Foreground="#FEFAE1" FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="ReminderTitle" Foreground="White" FontSize="15"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="ReminderNotes" Foreground="#B0A090" FontSize="12"
                               TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="{loc:Loc Main_Snooze}" Click="ReminderSnooze_Click" Margin="0,0,8,0"
                                Style="{StaticResource RoundedButton}"/>
                        <Button Content="{loc:Loc Main_Done}" Click="ReminderDone_Click"
                                Style="{StaticResource CancelButton}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- 拖拽上传遮罩（仅展开态显示） -->
            <Border x:Name="DropOverlay" Grid.RowSpan="2"
                    Width="420" Height="840"
                    CornerRadius="25"
                    Background="#D9362F2B"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="{loc:Loc Common_DragToAttach}"
                               Foreground="White" FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc Common_AttachmentLimit}"
                               Foreground="#CCFFFFFF" FontSize="12" Margin="0,10,0,0"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>


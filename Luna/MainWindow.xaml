<Window x:Class="SiriBlobDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize">

    <Grid>
        <Path x:Name="Blob"
              Fill="Black"
              SnapsToDevicePixels="True">
            <Path.Effect>
                <DropShadowEffect
                    BlurRadius="18"
                    ShadowDepth="8"
                    Opacity="0.18"/>
            </Path.Effect>
        </Path>
    </Grid>

</Window>
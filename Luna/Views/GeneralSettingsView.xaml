<UserControl x:Class="Luna.Views.GeneralSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:Luna.Models"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="700">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/SettingsStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel PreviewMouseDown="Root_PreviewMouseDown">
        <!-- 字体 -->
        <Border Style="{StaticResource SettingsCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="字体" Style="{StaticResource SettingsTitle}"/>
                    <TextBlock Text="界面使用的字体。" Style="{StaticResource SettingsDesc}" Margin="0"/>
                </StackPanel>
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <Border x:Name="FontDropdown" Width="250" Height="{StaticResource SettingsControlHeight}"
                            Background="#D4D0BA" CornerRadius="6" Padding="10,0" Cursor="Hand"
                            PreviewMouseLeftButtonDown="SelectToggle_Click"
                            Tag="{Binding FontSetting}">
                        <Grid>
                            <TextBlock Text="{Binding FontSetting.SelectedLabel}" Foreground="#5B4833"
                                       FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="▾" Foreground="#5B4833" FontSize="10" VerticalAlignment="Center"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>
                    <Popup IsOpen="{Binding FontSetting.IsOpen}"
                           PlacementTarget="{Binding ElementName=FontDropdown}"
                           Placement="Bottom" StaysOpen="True" AllowsTransparency="True">
                        <Border Background="#FFFFFF" CornerRadius="10" Padding="5" MaxWidth="350">
                            <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding FontSetting.Options}" Tag="{Binding FontSetting}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:SelectOption}">
                                            <Border Padding="10,8" CornerRadius="6" Cursor="Hand" Background="Transparent"
                                                    PreviewMouseLeftButtonDown="SelectOption_Click">
                                                <TextBlock Text="{Binding Label}" Foreground="#5B4833" FontSize="13"
                                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>
            </Grid>
        </Border>

        <!-- 快捷键 -->
        <Border Style="{StaticResource SettingsCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="快捷键" Style="{StaticResource SettingsTitle}"/>
                    <TextBlock Text="呼出胶囊窗口的全局快捷键，点击右侧输入框后按下组合键。" Style="{StaticResource SettingsDesc}" Margin="0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BindCopilotButton" Content="绑定到Copilot"
                            Click="BindCopilot_Click" Margin="0,0,10,0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#8B7B6B"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="Padding" Value="2,0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Foreground" Value="#5B4833"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Foreground" Value="#3D3327"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Grid>
                        <TextBox x:Name="HotkeyBox" Width="180" Style="{StaticResource SettingsInputWide}"
                                 IsReadOnly="True" Cursor="Hand"
                                 Text="{Binding HotkeyDisplay, Mode=OneWay}"
                                 GotFocus="HotkeyBox_GotFocus"
                                 LostFocus="HotkeyBox_LostFocus"
                                 PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
                        <TextBlock x:Name="HotkeyHint" Text="请按下快捷键…" Foreground="#8B7B6B" FontSize="12"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                   IsHitTestVisible="False" Visibility="Collapsed"/>
                    </Grid>
                    <Button Style="{StaticResource SettingsResetButton}"
                            Command="{Binding ResetHotkeyCommand}" Margin="6,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 代理 -->
        <Border Style="{StaticResource SettingsCard}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="代理" Style="{StaticResource SettingsTitle}"/>
                        <TextBlock Text="通过代理访问网络。" Style="{StaticResource SettingsDesc}" Margin="0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid>
                            <Border x:Name="ProxyDropdown" Width="180" Height="{StaticResource SettingsControlHeight}"
                                    Background="#D4D0BA" CornerRadius="6" Padding="10,0" Cursor="Hand"
                                    PreviewMouseLeftButtonDown="SelectToggle_Click"
                                    Tag="{Binding ProxyTypeSetting}">
                                <Grid>
                                    <TextBlock Text="{Binding ProxyTypeSetting.SelectedLabel}" Foreground="#5B4833"
                                               FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="▾" Foreground="#5B4833" FontSize="10" VerticalAlignment="Center"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                            <Popup IsOpen="{Binding ProxyTypeSetting.IsOpen}"
                                   PlacementTarget="{Binding ElementName=ProxyDropdown}"
                                   Placement="Bottom" StaysOpen="True" AllowsTransparency="True">
                                <Border Background="#FFFFFF" CornerRadius="10" Padding="5" MaxWidth="350">
                                    <ItemsControl ItemsSource="{Binding ProxyTypeSetting.Options}" Tag="{Binding ProxyTypeSetting}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:SelectOption}">
                                                <Border Padding="10,8" CornerRadius="6" Cursor="Hand" Background="Transparent"
                                                        PreviewMouseLeftButtonDown="SelectOption_Click">
                                                    <TextBlock Text="{Binding Label}" Foreground="#5B4833" FontSize="13" TextWrapping="Wrap"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </Popup>
                        </Grid>
                        <Button Style="{StaticResource SettingsResetButton}"
                                Command="{Binding ResetProxyTypeCommand}" Margin="6,0,0,0"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="服务器" Style="{StaticResource SettingsTitle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox Width="180" Style="{StaticResource SettingsInputWide}"
                                 Text="{Binding ProxyServer, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Center"/>
                        <Button Style="{StaticResource SettingsResetButton}"
                                Command="{Binding ResetProxyServerCommand}" Margin="6,0,0,0"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="端口" Style="{StaticResource SettingsTitle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox Width="180" Style="{StaticResource SettingsInputWide}"
                                 Text="{Binding ProxyPort, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Center"/>
                        <Button Style="{StaticResource SettingsResetButton}"
                                Command="{Binding ResetProxyPortCommand}" Margin="6,0,0,0"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="用户名" Style="{StaticResource SettingsTitle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox Width="180" Style="{StaticResource SettingsInputWide}"
                                 Text="{Binding ProxyUsername, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Center"/>
                        <Button Style="{StaticResource SettingsResetButton}"
                                Command="{Binding ResetProxyUsernameCommand}" Margin="6,0,0,0"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="密码" Style="{StaticResource SettingsTitle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <PasswordBox x:Name="ProxyPasswordBox" Width="180"
                                     Style="{StaticResource SettingsPassword}"
                                     PasswordChanged="ProxyPassword_PasswordChanged"
                                     VerticalAlignment="Center"/>
                        <Button Style="{StaticResource SettingsResetButton}"
                                Click="ResetProxyPassword_Click" Margin="6,0,0,0"/>
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="测试" Style="{StaticResource SecondaryActionButton}"
                            Command="{Binding TestProxyCommand}"/>
                    <TextBlock Text="{Binding ProxyTestStatus}" Foreground="#5B4833" FontSize="13"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 保存 -->
        <StackPanel Orientation="Horizontal" Margin="0,10,0,2">
            <Button Content="保存" Style="{StaticResource PrimaryActionButton}"
                    Command="{Binding SaveCommand}"/>
            <TextBlock Text="{Binding SaveStatus}" Foreground="#78A29F" FontSize="13"
                       VerticalAlignment="Center" Margin="10,0,0,0"/>
        </StackPanel>

        <!-- 编辑配置文件 -->
        <Button x:Name="EditSettingsJsonButton"
                Content="编辑 settings.json"
                Click="EditSettingsJson_Click"
                HorizontalAlignment="Left"
                Margin="0,6,0,8">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Height" Value="34"/>
                    <Setter Property="Padding" Value="20,0"/>
                    <Setter Property="Background" Value="#FD7956"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" CornerRadius="8" Padding="{TemplateBinding Padding}"
                                        Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#D64541"/></Trigger>
                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bg" Property="Background" Value="#A93226"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>
    </StackPanel>
</UserControl>

<UserControl x:Class="Luna.Views.GeneralSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:Luna.Models"
             xmlns:loc="clr-namespace:Luna.Localization"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="700">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/SettingsStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel PreviewMouseDown="Root_PreviewMouseDown">
        <!-- 字体 -->
        <Border Style="{StaticResource SettingsCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{loc:Loc Settings_Font_Title}" Style="{StaticResource SettingsTitle}"/>
                    <TextBlock Text="{loc:Loc Settings_Font_Desc}" Style="{StaticResource SettingsDesc}" Margin="0"/>
                </StackPanel>
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <Border x:Name="FontDropdown" Width="250" Height="{StaticResource SettingsControlHeight}"
                            Background="#D4D0BA" CornerRadius="6" Padding="10,0" Cursor="Hand"
                            PreviewMouseLeftButtonDown="SelectToggle_Click"
                            Tag="{Binding FontSetting}">
                        <Grid>
                            <TextBlock Text="{Binding FontSetting.SelectedLabel}" Foreground="#5B4833"
                                       FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="▾" Foreground="#5B4833" FontSize="10" VerticalAlignment="Center"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>
                    <Popup IsOpen="{Binding FontSetting.IsOpen}"
                           PlacementTarget="{Binding ElementName=FontDropdown}"
                           Placement="Bottom" StaysOpen="True" AllowsTransparency="True">
                        <Border Background="#FFFFFF" CornerRadius="10" Padding="5" MaxWidth="350">
                            <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding FontSetting.Options}" Tag="{Binding FontSetting}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:SelectOption}">
                                            <Border Padding="10,8" CornerRadius="6" Cursor="Hand" Background="Transparent"
                                                    PreviewMouseLeftButtonDown="SelectOption_Click">
                                                <TextBlock Text="{Binding Label}" Foreground="#5B4833" FontSize="13"
                                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>
            </Grid>
        </Border>

        <!-- 语言 -->
        <Border Style="{StaticResource SettingsCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{loc:Loc Settings_Language_Title}" Style="{StaticResource SettingsTitle}"/>
                    <TextBlock Text="{loc:Loc Settings_Language_Desc}" Style="{StaticResource SettingsDesc}" Margin="0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid>
                        <Border x:Name="LanguageDropdown" Width="180" Height="{StaticResource SettingsControlHeight}"
                                Background="#D4D0BA" CornerRadius="6" Padding="10,0" Cursor="Hand"
                                PreviewMouseLeftButtonDown="SelectToggle_Click"
                                Tag="{Binding LanguageSetting}">
                            <Grid>
                                <TextBlock Text="{Binding LanguageSetting.SelectedLabel}" Foreground="#5B4833"
                                           FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="▾" Foreground="#5B4833" FontSize="10" VerticalAlignment="Center"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                        <Popup IsOpen="{Binding LanguageSetting.IsOpen}"
                               PlacementTarget="{Binding ElementName=LanguageDropdown}"
                               Placement="Bottom" StaysOpen="True" AllowsTransparency="True">
                            <Border Background="#FFFFFF" CornerRadius="10" Padding="5" MaxWidth="350">
                                <ItemsControl ItemsSource="{Binding LanguageSetting.Options}" Tag="{Binding LanguageSetting}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:SelectOption}">
                                            <Border Padding="10,8" CornerRadius="6" Cursor="Hand" Background="Transparent"
                                                    PreviewMouseLeftButtonDown="SelectOption_Click">
                                                <TextBlock Text="{Binding Label}" Foreground="#5B4833" FontSize="13" TextWrapping="Wrap"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </Popup>
                    </Grid>
                    <Button Style="{StaticResource SettingsResetButton}"
                            Click="ResetLanguage_Click" Margin="6,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 快捷键 -->
        <Border Style="{StaticResource SettingsCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{loc:Loc Settings_Hotkey_Title}" Style="{StaticResource SettingsTitle}"/>
                    <TextBlock Text="{loc:Loc Settings_Hotkey_Desc}" Style="{StaticResource SettingsDesc}" Margin="0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BindCopilotButton" Content="{loc:Loc Settings_Hotkey_BindCopilot}"
                            Click="BindCopilot_Click" Margin="0,0,10,0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#8B7B6B"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="Padding" Value="2,0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Foreground" Value="#5B4833"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Foreground" Value="#3D3327"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Grid>
                        <TextBox x:Name="HotkeyBox" Width="180" Style="{StaticResource SettingsInputWide}"
                                 IsReadOnly="True" Cursor="Hand"
                                 Text="{Binding HotkeyDisplay, Mode=OneWay}"
                                 GotFocus="HotkeyBox_GotFocus"
                                 LostFocus="HotkeyBox_LostFocus"
                                 PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
                        <TextBlock x:Name="HotkeyHint" Text="{loc:Loc Settings_Hotkey_PressPrompt}" Foreground="#8B7B6B" FontSize="12"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                   IsHitTestVisible="False" Visibility="Collapsed"/>
                    </Grid>
                    <Button Style="{StaticResource SettingsResetButton}"
                            Command="{Binding ResetHotkeyCommand}" Margin="6,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 开机自启动 -->
        <Border Style="{StaticResource SettingsCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{loc:Loc Settings_Startup_Title}" Style="{StaticResource SettingsTitle}"/>
                    <TextBlock Text="{loc:Loc Settings_Startup_Desc}" Style="{StaticResource SettingsDesc}" Margin="0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid>
                        <Border x:Name="StartupDropdown" Width="180" Height="{StaticResource SettingsControlHeight}"
                                Background="#D4D0BA" CornerRadius="6" Padding="10,0" Cursor="Hand"
                                PreviewMouseLeftButtonDown="SelectToggle_Click"
                                Tag="{Binding StartupSetting}">
                            <Grid>
                                <TextBlock Text="{Binding StartupSetting.SelectedLabel}" Foreground="#5B4833"
                                           FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="▾" Foreground="#5B4833" FontSize="10" VerticalAlignment="Center"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                        <Popup IsOpen="{Binding StartupSetting.IsOpen}"
                               PlacementTarget="{Binding ElementName=StartupDropdown}"
                               Placement="Bottom" StaysOpen="True" AllowsTransparency="True">
                            <Border Background="#FFFFFF" CornerRadius="10" Padding="5" MaxWidth="350">
                                <ItemsControl ItemsSource="{Binding StartupSetting.Options}" Tag="{Binding StartupSetting}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:SelectOption}">
                                            <Border Padding="10,8" CornerRadius="6" Cursor="Hand" Background="Transparent"
                                                    PreviewMouseLeftButtonDown="SelectOption_Click">
                                                <TextBlock Text="{Binding Label}" Foreground="#5B4833" FontSize="13" TextWrapping="Wrap"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </Popup>
                    </Grid>
                    <Button Style="{StaticResource SettingsResetButton}"
                            Command="{Binding ResetStartupCommand}" Margin="6,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 代理 -->
        <Border Style="{StaticResource SettingsCard}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{loc:Loc Settings_Proxy_Title}" Style="{StaticResource SettingsTitle}"/>
                        <TextBlock Text="{loc:Loc Settings_Proxy_Desc}" Style="{StaticResource SettingsDesc}" Margin="0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid>
                            <Border x:Name="ProxyDropdown" Width="180" Height="{StaticResource SettingsControlHeight}"
                                    Background="#D4D0BA" CornerRadius="6" Padding="10,0" Cursor="Hand"
                                    PreviewMouseLeftButtonDown="SelectToggle_Click"
                                    Tag="{Binding ProxyTypeSetting}">
                                <Grid>
                                    <TextBlock Text="{Binding ProxyTypeSetting.SelectedLabel}" Foreground="#5B4833"
                                               FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="▾" Foreground="#5B4833" FontSize="10" VerticalAlignment="Center"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                            <Popup IsOpen="{Binding ProxyTypeSetting.IsOpen}"
                                   PlacementTarget="{Binding ElementName=ProxyDropdown}"
                                   Placement="Bottom" StaysOpen="True" AllowsTransparency="True">
                                <Border Background="#FFFFFF" CornerRadius="10" Padding="5" MaxWidth="350">
                                    <ItemsControl ItemsSource="{Binding ProxyTypeSetting.Options}" Tag="{Binding ProxyTypeSetting}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:SelectOption}">
                                                <Border Padding="10,8" CornerRadius="6" Cursor="Hand" Background="Transparent"
                                                        PreviewMouseLeftButtonDown="SelectOption_Click">
                                                    <TextBlock Text="{Binding Label}" Foreground="#5B4833" FontSize="13" TextWrapping="Wrap"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </Popup>
                        </Grid>
                        <Button Style="{StaticResource SettingsResetButton}"
                                Command="{Binding ResetProxyTypeCommand}" Margin="6,0,0,0"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{loc:Loc Settings_Proxy_Server}" Style="{StaticResource SettingsTitle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox Width="180" Style="{StaticResource SettingsInputWide}"
                                 Text="{Binding ProxyServer, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Center"/>
                        <Button Style="{StaticResource SettingsResetButton}"
                                Command="{Binding ResetProxyServerCommand}" Margin="6,0,0,0"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{loc:Loc Settings_Proxy_Port}" Style="{StaticResource SettingsTitle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox Width="180" Style="{StaticResource SettingsInputWide}"
                                 Text="{Binding ProxyPort, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Center"/>
                        <Button Style="{StaticResource SettingsResetButton}"
                                Command="{Binding ResetProxyPortCommand}" Margin="6,0,0,0"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{loc:Loc Settings_Proxy_Username}" Style="{StaticResource SettingsTitle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox Width="180" Style="{StaticResource SettingsInputWide}"
                                 Text="{Binding ProxyUsername, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Center"/>
                        <Button Style="{StaticResource SettingsResetButton}"
                                Command="{Binding ResetProxyUsernameCommand}" Margin="6,0,0,0"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{loc:Loc Settings_Proxy_Password}" Style="{StaticResource SettingsTitle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <PasswordBox x:Name="ProxyPasswordBox" Width="180"
                                     Style="{StaticResource SettingsPassword}"
                                     PasswordChanged="ProxyPassword_PasswordChanged"
                                     VerticalAlignment="Center"/>
                        <Button Style="{StaticResource SettingsResetButton}"
                                Click="ResetProxyPassword_Click" Margin="6,0,0,0"/>
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="{loc:Loc Settings_Proxy_TestButton}" Style="{StaticResource SecondaryActionButton}"
                            Command="{Binding TestProxyCommand}"/>
                    <TextBlock Text="{Binding ProxyTestStatus}" Foreground="#5B4833" FontSize="13"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 输出目录 -->
        <Border Style="{StaticResource SettingsCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{loc:Loc Settings_Output_Title}" Style="{StaticResource SettingsTitle}"/>
                    <TextBlock Text="{loc:Loc Settings_Output_Desc}" Style="{StaticResource SettingsDesc}" Margin="0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox Width="240" Style="{StaticResource SettingsInputWide}"
                             Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}"
                             VerticalAlignment="Center"/>
                    <Button Content="{loc:Loc Settings_Output_Browse}" Style="{StaticResource SecondaryActionButton}"
                            Padding="12,6" Margin="6,0,0,0" Click="BrowseOutputDirectory_Click"/>
                    <Button Style="{StaticResource SettingsResetButton}"
                            Command="{Binding ResetOutputDirectoryCommand}" Margin="6,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 数据备份 -->
        <Border Style="{StaticResource SettingsCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{loc:Loc Settings_Backup_Title}" Style="{StaticResource SettingsTitle}"/>
                    <TextBlock Text="{loc:Loc Settings_Backup_Desc}" Style="{StaticResource SettingsDesc}" Margin="0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding BackupStatus}" Foreground="#78A29F" FontSize="13"
                               VerticalAlignment="Center" Margin="0,0,12,0"
                               MaxWidth="320" TextWrapping="Wrap"/>
                    <Button Content="{loc:Loc Settings_Backup_ExportButton}" Style="{StaticResource SecondaryActionButton}"
                            Padding="12,6" Command="{Binding ExportDataCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 工具授权 -->
        <Border Style="{StaticResource SettingsCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{loc:Loc Settings_ToolPermissions_Title}" Style="{StaticResource SettingsTitle}"/>
                    <TextBlock Text="{loc:Loc Settings_ToolPermissions_Desc}" Style="{StaticResource SettingsDesc}" Margin="0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ToolPermissionStatus}" Foreground="#78A29F" FontSize="13"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Content="{loc:Loc Settings_ToolPermissions_Clear}" Style="{StaticResource SecondaryActionButton}"
                            Padding="12,6" Command="{Binding ClearPersistentToolPermissionsCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 软件更新 -->
        <Border Style="{StaticResource SettingsCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{loc:Loc Settings_Update_Title}" Style="{StaticResource SettingsTitle}"/>
                    <TextBlock Text="{loc:Loc Settings_Update_Desc}" Style="{StaticResource SettingsDesc}" Margin="0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding UpdateStatus}" Foreground="#5B4833" FontSize="13"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Content="{loc:Loc Settings_Update_CheckButton}" Style="{StaticResource SecondaryActionButton}"
                            Padding="12,6" Command="{Binding CheckUpdateCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 自动保存状态 -->
        <TextBlock Text="{Binding SaveStatus}" Foreground="#78A29F" FontSize="13"
                   HorizontalAlignment="Left" Margin="0,10,0,2">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SaveStatus}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- 编辑配置文件 -->
        <Button x:Name="EditSettingsJsonButton"
                Content="{loc:Loc Settings_EditConfig_Button}"
                Click="EditSettingsJson_Click"
                HorizontalAlignment="Left"
                Margin="0,6,0,8">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Height" Value="34"/>
                    <Setter Property="Padding" Value="20,0"/>
                    <Setter Property="Background" Value="#FD7956"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" CornerRadius="8" Padding="{TemplateBinding Padding}"
                                        Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#D64541"/></Trigger>
                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bg" Property="Background" Value="#A93226"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>
    </StackPanel>
</UserControl>

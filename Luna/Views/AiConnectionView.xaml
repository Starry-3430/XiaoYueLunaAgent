<UserControl x:Class="Luna.Views.AiConnectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:Luna.Models"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="700">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/SettingsStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <!-- 多行输入框（提示词） -->
            <Style x:Key="SettingsMultiline" TargetType="TextBox" BasedOn="{StaticResource SettingsInputWide}">
                <Setter Property="Width" Value="360"/>
                <Setter Property="Height" Value="100"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="AcceptsReturn" Value="True"/>
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="VerticalContentAlignment" Value="Top"/>
            </Style>

            <!-- 加密输入框（API Key） -->
            <Style x:Key="SettingsPassword" TargetType="PasswordBox">
                <Setter Property="Background" Value="#D4D0BA"/>
                <Setter Property="Foreground" Value="#5B4833"/>
                <Setter Property="CaretBrush" Value="#5B4833"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Height" Value="{StaticResource SettingsControlHeight}"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Width" Value="180"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="PasswordChar" Value="●"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="PasswordBox">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ScrollViewer x:Name="PART_ContentHost"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 主操作按钮 -->
            <Style x:Key="PrimaryActionButton" TargetType="Button">
                <Setter Property="Background" Value="#85B2AF"/>
                <Setter Property="Foreground" Value="#FEFAE1"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="18,9"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#96C2BF"/></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bg" Property="Background" Value="#78A29F"/></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bg" Property="Opacity" Value="0.5"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SecondaryActionButton" TargetType="Button">
                <Setter Property="Background" Value="#D4D0BA"/>
                <Setter Property="Foreground" Value="#5B4833"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="18,9"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#DDD9C5"/></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bg" Property="Background" Value="#C9C5AF"/></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bg" Property="Opacity" Value="0.5"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel PreviewMouseDown="Root_PreviewMouseDown">
        <!-- 昵称 -->
        <Border Style="{StaticResource SettingsCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="昵称" Style="{StaticResource SettingsTitle}"/>
                    <TextBlock Text="AI 的名字，会代入系统提示词。" Style="{StaticResource SettingsDesc}" Margin="0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox Style="{StaticResource SettingsInputWide}"
                             Text="{Binding Nickname, UpdateSourceTrigger=PropertyChanged}"
                             VerticalAlignment="Center"/>
                    <Button Style="{StaticResource SettingsResetButton}"
                            Command="{Binding ResetNicknameCommand}" Margin="6,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 用户称呼 -->
        <Border Style="{StaticResource SettingsCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="用户称呼" Style="{StaticResource SettingsTitle}"/>
                    <TextBlock Text="AI 对你的称呼，会代入系统提示词。" Style="{StaticResource SettingsDesc}" Margin="0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox Style="{StaticResource SettingsInputWide}"
                             Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                             VerticalAlignment="Center"/>
                    <Button Style="{StaticResource SettingsResetButton}"
                            Command="{Binding ResetUserNameCommand}" Margin="6,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 提示词 -->
        <Border Style="{StaticResource SettingsCard}">
            <StackPanel>
                <TextBlock Text="提示词" Style="{StaticResource SettingsTitle}"/>
                <TextBlock Text="可用占位符：{nickname}（AI 昵称）、{user}（用户称呼）。" Style="{StaticResource SettingsDesc}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBox Style="{StaticResource SettingsMultiline}"
                             HorizontalAlignment="Left"
                             Text="{Binding SystemPrompt, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Style="{StaticResource SettingsResetButton}"
                            Command="{Binding ResetSystemPromptCommand}"
                            Margin="6,0,0,0" VerticalAlignment="Top"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 提供商 -->
        <Border Style="{StaticResource SettingsCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="提供商" Style="{StaticResource SettingsTitle}"/>
                    <TextBlock Text="选择模型服务提供商，自动填充 Base URL 与模型。" Style="{StaticResource SettingsDesc}" Margin="0"/>
                </StackPanel>
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <Border x:Name="ProviderDropdown" Width="250" Height="{StaticResource SettingsControlHeight}"
                            Background="#D4D0BA" CornerRadius="6" Padding="10,0" Cursor="Hand"
                            PreviewMouseLeftButtonDown="SelectToggle_Click"
                            Tag="{Binding ProviderSetting}">
                        <Grid>
                            <TextBlock Text="{Binding ProviderSetting.SelectedLabel}" Foreground="#5B4833"
                                       FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="▾" Foreground="#5B4833" FontSize="10" VerticalAlignment="Center"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>
                    <Popup IsOpen="{Binding ProviderSetting.IsOpen}"
                           PlacementTarget="{Binding ElementName=ProviderDropdown}"
                           Placement="Bottom" StaysOpen="True" AllowsTransparency="True">
                        <Border Background="#FFFFFF" CornerRadius="10" Padding="5" MaxWidth="350">
                            <ItemsControl ItemsSource="{Binding ProviderSetting.Options}" Tag="{Binding ProviderSetting}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:SelectOption}">
                                        <Border Padding="10,8" CornerRadius="6" Cursor="Hand" Background="Transparent"
                                                PreviewMouseLeftButtonDown="SelectOption_Click">
                                            <TextBlock Text="{Binding Label}" Foreground="#5B4833" FontSize="13" TextWrapping="Wrap"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </Popup>
                </Grid>
            </Grid>
        </Border>

        <!-- 模型 -->
        <Border Style="{StaticResource SettingsCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="模型" Style="{StaticResource SettingsTitle}"/>
                    <TextBlock Text="从预设选择，或选「自定义」手动填写模型名。" Style="{StaticResource SettingsDesc}" Margin="0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Grid>
                        <Border x:Name="ModelDropdown" Width="250" Height="{StaticResource SettingsControlHeight}"
                                Background="#D4D0BA" CornerRadius="6" Padding="10,0" Cursor="Hand"
                                PreviewMouseLeftButtonDown="SelectToggle_Click"
                                Tag="{Binding ModelSetting}">
                            <Grid>
                                <TextBlock Text="{Binding ModelSetting.SelectedLabel}" Foreground="#5B4833"
                                           FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="▾" Foreground="#5B4833" FontSize="10" VerticalAlignment="Center"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                        <Popup IsOpen="{Binding ModelSetting.IsOpen}"
                               PlacementTarget="{Binding ElementName=ModelDropdown}"
                               Placement="Bottom" StaysOpen="True" AllowsTransparency="True">
                            <Border Background="#FFFFFF" CornerRadius="10" Padding="5" MaxWidth="350">
                                <ItemsControl ItemsSource="{Binding ModelSetting.Options}" Tag="{Binding ModelSetting}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:SelectOption}">
                                            <Border Padding="10,8" CornerRadius="6" Cursor="Hand" Background="Transparent"
                                                    PreviewMouseLeftButtonDown="SelectOption_Click">
                                                <TextBlock Text="{Binding Label}" Foreground="#5B4833" FontSize="13" TextWrapping="Wrap"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </Popup>
                    </Grid>
                    <TextBox Style="{StaticResource SettingsInputWide}"
                             Margin="0,8,0,0"
                             Text="{Binding CustomModel, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding IsCustomModel, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Base URL -->
        <Border Style="{StaticResource SettingsCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Base URL" Style="{StaticResource SettingsTitle}"/>
                    <TextBlock Text="API 地址，切换提供商时自动填充，可手动覆盖。" Style="{StaticResource SettingsDesc}" Margin="0"/>
                </StackPanel>
                <TextBox Grid.Column="1" Style="{StaticResource SettingsInputWide}"
                         Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- API Key -->
        <Border Style="{StaticResource SettingsCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="API Key" Style="{StaticResource SettingsTitle}"/>
                    <TextBlock Text="密钥使用 Windows DPAPI 加密后保存在本地。" Style="{StaticResource SettingsDesc}" Margin="0"/>
                </StackPanel>
                <PasswordBox x:Name="ApiKeyBox" Grid.Column="1"
                             Style="{StaticResource SettingsPassword}"
                             PasswordChanged="ApiKey_PasswordChanged"
                             VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Max Tokens -->
        <Border Style="{StaticResource SettingsCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Max Tokens" Style="{StaticResource SettingsTitle}"/>
                    <TextBlock Text="单次回复允许的最大 token 数。" Style="{StaticResource SettingsDesc}" Margin="0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox Style="{StaticResource SettingsInput}"
                             Text="{Binding MaxTokens, UpdateSourceTrigger=PropertyChanged}"
                             VerticalAlignment="Center"/>
                    <Button Style="{StaticResource SettingsResetButton}"
                            Command="{Binding ResetMaxTokensCommand}" Margin="6,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 温度 -->
        <Border Style="{StaticResource SettingsCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="温度" Style="{StaticResource SettingsTitle}"/>
                    <TextBlock Text="采样温度，越高越发散（0 ~ 2.0）。" Style="{StaticResource SettingsDesc}" Margin="0"/>
                </StackPanel>
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="−" Style="{StaticResource SettingsStepperButton}" Command="{Binding DecreaseTemperatureCommand}"/>
                    <TextBox x:Name="TemperatureBox" Grid.Column="1" Width="80" Height="{StaticResource SettingsControlHeight}" Margin="6,0"
                             Style="{StaticResource SettingsInput}"
                             Text="{Binding TemperatureText, UpdateSourceTrigger=PropertyChanged}"
                             TextAlignment="Center"
                             LostFocus="TemperatureBox_LostFocus"
                             VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Content="+" Style="{StaticResource SettingsStepperButton}" Command="{Binding IncreaseTemperatureCommand}" Margin="0,0,6,0"/>
                    <Button Grid.Column="3" Style="{StaticResource SettingsResetButton}"
                            Command="{Binding ResetTemperatureCommand}" VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Border>

        <!-- 操作区 -->
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <Button Content="连接测试" Style="{StaticResource SecondaryActionButton}"
                    Command="{Binding TestConnectionCommand}" Margin="0,0,8,0"/>
            <Button Content="保存" Style="{StaticResource PrimaryActionButton}"
                    Command="{Binding SaveCommand}"/>
            <TextBlock Text="{Binding TestStatus}" Foreground="#5B4833" FontSize="13"
                       VerticalAlignment="Center" Margin="12,0,0,0"/>
            <TextBlock Text="{Binding SaveStatus}" Foreground="#78A29F" FontSize="13"
                       VerticalAlignment="Center" Margin="8,0,0,0"/>
        </StackPanel>
    </StackPanel>
</UserControl>

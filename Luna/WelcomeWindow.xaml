<Window x:Class="Luna.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:Luna.Models"
        xmlns:loc="clr-namespace:Luna.Localization"
        Title="Luna"
        Width="680" Height="560"
        WindowStyle="SingleBorderWindow"
        AllowsTransparency="False"
        Background="#E4E0CA"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!-- 保留 WindowChrome，系统才会把它当作标准窗口并播放原生动画 -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="60" ResizeBorderThickness="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/SettingsStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <PathGeometry x:Key="IconMinimize" Figures="M5 12 H19"/>
            <PathGeometry x:Key="IconClose" Figures="M18 6 L6 18 M6 6 L18 18"/>

            <Style x:Key="LineIconGlyph" TargetType="Path">
                <Setter Property="Stroke" Value="#5B4833"/>
                <Setter Property="StrokeThickness" Value="2"/>
                <Setter Property="StrokeStartLineCap" Value="Round"/>
                <Setter Property="StrokeEndLineCap" Value="Round"/>
                <Setter Property="StrokeLineJoin" Value="Round"/>
                <Setter Property="Fill" Value="Transparent"/>
            </Style>

            <Style x:Key="WindowControlButton" TargetType="Button">
                <Setter Property="Width" Value="40"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6" Margin="2">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#D4D0BA"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#C9C5AF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="WelcomeTitle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#5B4833"/>
                <Setter Property="FontSize" Value="22"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <Style x:Key="WelcomeSubtitle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#8B7B6B"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,8,0,0"/>
            </Style>

            <Style x:Key="WelcomeCardLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#5B4833"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <Style x:Key="WelcomeCardDesc" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#8B7B6B"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,2,0,0"/>
            </Style>

            <Style x:Key="WelcomeExpanderButton" TargetType="Button" BasedOn="{StaticResource SecondaryActionButton}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#78A29F"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
            </Style>

            <Style x:Key="WelcomeStepLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#8B7B6B"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="RootContent" Opacity="0" PreviewMouseDown="Root_PreviewMouseDown">
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>

            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="80"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5">
                    <Button x:Name="MinButton" Style="{StaticResource WindowControlButton}"
                            WindowChrome.IsHitTestVisibleInChrome="True" Click="MinButton_Click">
                        <Viewbox Width="14" Height="14">
                            <Canvas Width="24" Height="24">
                                <Path Style="{StaticResource LineIconGlyph}" Data="{StaticResource IconMinimize}"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource WindowControlButton}"
                            WindowChrome.IsHitTestVisibleInChrome="True" Click="CloseButton_Click">
                        <Viewbox Width="14" Height="14">
                            <Canvas Width="24" Height="24">
                                <Path Style="{StaticResource LineIconGlyph}" Data="{StaticResource IconClose}"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 步骤内容区 -->
            <Grid x:Name="StepHost" Grid.Row="1" Margin="36,0,36,10">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="StepTranslate"/>
                </Grid.RenderTransform>

                <!-- 第一步：昵称 -->
                <Grid Visibility="{Binding IsStep1, Converter={StaticResource BoolToVis}}">
                    <StackPanel VerticalAlignment="Center" MaxWidth="520">
                        <TextBlock Text="{loc:Loc Welcome_Step1_Greeting}" Style="{StaticResource WelcomeTitle}"
                                   Margin="4,0,4,24"/>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Welcome_Step1_AiNameLabel}" Style="{StaticResource WelcomeCardLabel}"/>
                                <TextBlock Text="{loc:Loc Welcome_Step1_AiNameDesc}" Style="{StaticResource WelcomeCardDesc}"/>
                                <TextBox Style="{StaticResource SettingsInputWide}"
                                         Margin="0,10,0,0"
                                         HorizontalAlignment="Stretch"
                                         Width="Auto"
                                         FontSize="14"
                                         Text="{Binding AiNickname, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Welcome_Step1_UserNameLabel}" Style="{StaticResource WelcomeCardLabel}"/>
                                <TextBlock Text="{loc:Loc Welcome_Step1_UserNameDesc}" Style="{StaticResource WelcomeCardDesc}"/>
                                <TextBox Style="{StaticResource SettingsInputWide}"
                                         Margin="0,10,0,0"
                                         HorizontalAlignment="Stretch"
                                         Width="Auto"
                                         FontSize="14"
                                         Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- 第二步：AI 连接 -->
                <Grid Visibility="{Binding IsStep2, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="4,0,4,14">
                        <TextBlock Text="{loc:Loc Welcome_Step2_Title}" Style="{StaticResource WelcomeTitle}"/>
                        <TextBlock Text="{loc:Loc Welcome_Step2_Desc}" Style="{StaticResource WelcomeSubtitle}"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,8,0">
                            <!-- 提供商 -->
                            <Border Style="{StaticResource SettingsCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{loc:Loc AiConnection_Provider_Title}" Style="{StaticResource WelcomeCardLabel}"/>
                                    </StackPanel>
                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                        <Border x:Name="ProviderDropdown" Width="240" Height="{StaticResource SettingsControlHeight}"
                                                Background="#D4D0BA" CornerRadius="6" Padding="10,0" Cursor="Hand"
                                                PreviewMouseLeftButtonDown="SelectToggle_Click"
                                                Tag="{Binding ProviderSetting}">
                                            <Grid>
                                                <TextBlock Text="{Binding ProviderSetting.SelectedLabel}" Foreground="#5B4833"
                                                           FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="▾" Foreground="#5B4833" FontSize="10" VerticalAlignment="Center"
                                                           HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                        <Popup IsOpen="{Binding ProviderSetting.IsOpen}"
                                               PlacementTarget="{Binding ElementName=ProviderDropdown}"
                                               Placement="Bottom" StaysOpen="True" AllowsTransparency="True">
                                            <Border Background="#FFFFFF" CornerRadius="10" Padding="5" MaxWidth="350">
                                                <ItemsControl ItemsSource="{Binding ProviderSetting.Options}" Tag="{Binding ProviderSetting}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type models:SelectOption}">
                                                            <Border Padding="10,8" CornerRadius="6" Cursor="Hand" Background="Transparent"
                                                                    PreviewMouseLeftButtonDown="SelectOption_Click">
                                                                <TextBlock Text="{Binding Label}" Foreground="#5B4833" FontSize="13" TextWrapping="Wrap"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- 模型 -->
                            <Border Style="{StaticResource SettingsCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{loc:Loc AiConnection_Model_Title}" Style="{StaticResource WelcomeCardLabel}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Grid>
                                            <Border x:Name="ModelDropdown" Width="240" Height="{StaticResource SettingsControlHeight}"
                                                    Background="#D4D0BA" CornerRadius="6" Padding="10,0" Cursor="Hand"
                                                    PreviewMouseLeftButtonDown="SelectToggle_Click"
                                                    Tag="{Binding ModelSetting}">
                                                <Grid>
                                                    <TextBlock Text="{Binding ModelSetting.SelectedLabel}" Foreground="#5B4833"
                                                               FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="▾" Foreground="#5B4833" FontSize="10" VerticalAlignment="Center"
                                                               HorizontalAlignment="Right"/>
                                                </Grid>
                                            </Border>
                                            <Popup IsOpen="{Binding ModelSetting.IsOpen}"
                                                   PlacementTarget="{Binding ElementName=ModelDropdown}"
                                                   Placement="Bottom" StaysOpen="True" AllowsTransparency="True">
                                                <Border Background="#FFFFFF" CornerRadius="10" Padding="5" MaxWidth="350">
                                                    <ItemsControl ItemsSource="{Binding ModelSetting.Options}" Tag="{Binding ModelSetting}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type models:SelectOption}">
                                                                <Border Padding="10,8" CornerRadius="6" Cursor="Hand" Background="Transparent"
                                                                        PreviewMouseLeftButtonDown="SelectOption_Click">
                                                                    <TextBlock Text="{Binding Label}" Foreground="#5B4833" FontSize="13" TextWrapping="Wrap"/>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Border>
                                            </Popup>
                                        </Grid>
                                        <TextBox Style="{StaticResource SettingsInputWide}"
                                                 Width="240"
                                                 Margin="0,8,0,0"
                                                 Text="{Binding CustomModel, UpdateSourceTrigger=PropertyChanged}"
                                                 Visibility="{Binding IsCustomModel, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Base URL -->
                            <Border Style="{StaticResource SettingsCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{loc:Loc AiConnection_BaseUrl_Title}" Style="{StaticResource WelcomeCardLabel}"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Style="{StaticResource SettingsInputWide}"
                                             Width="240"
                                             Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- API Key -->
                            <Border Style="{StaticResource SettingsCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{loc:Loc AiConnection_ApiKey_Title}" Style="{StaticResource WelcomeCardLabel}"/>
                                    </StackPanel>
                                    <PasswordBox x:Name="ApiKeyBox" Grid.Column="1"
                                                 Width="240"
                                                 Style="{StaticResource SettingsPassword}"
                                                 PasswordChanged="ApiKey_PasswordChanged"
                                                 VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- 连接测试 -->
                            <StackPanel Orientation="Horizontal" Margin="4,2,0,12">
                                <Button Content="{loc:Loc Welcome_Test_Button}" Style="{StaticResource SecondaryActionButton}"
                                        Command="{Binding TestConnectionCommand}"/>
                                <TextBlock Text="{Binding TestStatus}" Foreground="#5B4833" FontSize="13"
                                           VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- 代理（可选） -->
                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <Button Content="{loc:Loc Welcome_Advanced_Proxy}" Style="{StaticResource WelcomeExpanderButton}"
                                            Command="{Binding ToggleProxyCommand}"/>
                                    <StackPanel Margin="0,12,0,0"
                                                Visibility="{Binding IsProxyExpanded, Converter={StaticResource BoolToVis}}">
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{loc:Loc Settings_Proxy_Title}"
                                                       Style="{StaticResource WelcomeCardLabel}" VerticalAlignment="Center"/>
                                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                                <Border x:Name="ProxyDropdown" Width="240" Height="{StaticResource SettingsControlHeight}"
                                                        Background="#D4D0BA" CornerRadius="6" Padding="10,0" Cursor="Hand"
                                                        PreviewMouseLeftButtonDown="SelectToggle_Click"
                                                        Tag="{Binding ProxyTypeSetting}">
                                                    <Grid>
                                                        <TextBlock Text="{Binding ProxyTypeSetting.SelectedLabel}" Foreground="#5B4833"
                                                                   FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="▾" Foreground="#5B4833" FontSize="10" VerticalAlignment="Center"
                                                                   HorizontalAlignment="Right"/>
                                                    </Grid>
                                                </Border>
                                                <Popup IsOpen="{Binding ProxyTypeSetting.IsOpen}"
                                                       PlacementTarget="{Binding ElementName=ProxyDropdown}"
                                                       Placement="Bottom" StaysOpen="True" AllowsTransparency="True">
                                                    <Border Background="#FFFFFF" CornerRadius="10" Padding="5" MaxWidth="350">
                                                        <ItemsControl ItemsSource="{Binding ProxyTypeSetting.Options}" Tag="{Binding ProxyTypeSetting}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate DataType="{x:Type models:SelectOption}">
                                                                    <Border Padding="10,8" CornerRadius="6" Cursor="Hand" Background="Transparent"
                                                                            PreviewMouseLeftButtonDown="SelectOption_Click">
                                                                        <TextBlock Text="{Binding Label}" Foreground="#5B4833" FontSize="13" TextWrapping="Wrap"/>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Border>
                                                </Popup>
                                            </Grid>
                                        </Grid>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{loc:Loc Settings_Proxy_Server}"
                                                       Style="{StaticResource WelcomeCardLabel}" VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="1" Style="{StaticResource SettingsInputWide}" Width="240"
                                                     Text="{Binding ProxyServer, UpdateSourceTrigger=PropertyChanged}"
                                                     VerticalAlignment="Center"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{loc:Loc Settings_Proxy_Port}"
                                                       Style="{StaticResource WelcomeCardLabel}" VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="1" Style="{StaticResource SettingsInputWide}" Width="240"
                                                     Text="{Binding ProxyPort, UpdateSourceTrigger=PropertyChanged}"
                                                     VerticalAlignment="Center"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{loc:Loc Settings_Proxy_Username}"
                                                       Style="{StaticResource WelcomeCardLabel}" VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="1" Style="{StaticResource SettingsInputWide}" Width="240"
                                                     Text="{Binding ProxyUsername, UpdateSourceTrigger=PropertyChanged}"
                                                     VerticalAlignment="Center"/>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{loc:Loc Settings_Proxy_Password}"
                                                       Style="{StaticResource WelcomeCardLabel}" VerticalAlignment="Center"/>
                                            <PasswordBox x:Name="ProxyPasswordBox" Grid.Column="1"
                                                         Width="240"
                                                         Style="{StaticResource SettingsPassword}"
                                                         PasswordChanged="ProxyPassword_PasswordChanged"
                                                         VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 后台任务模型（可选） -->
                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <Button Content="{loc:Loc Welcome_Advanced_BackgroundModel}" Style="{StaticResource WelcomeExpanderButton}"
                                            Command="{Binding ToggleBackgroundModelCommand}"/>
                                    <StackPanel Margin="0,12,0,0"
                                                Visibility="{Binding IsBackgroundModelExpanded, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{loc:Loc Welcome_Advanced_BackgroundModel_Desc}"
                                                   Style="{StaticResource WelcomeCardDesc}" Margin="0,0,0,8"/>
                                        <TextBox Style="{StaticResource SettingsInputWide}"
                                                 HorizontalAlignment="Stretch" Width="Auto"
                                                 Text="{Binding BackgroundModel, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 第三步：完成 -->
                <Grid Visibility="{Binding IsStep3, Converter={StaticResource BoolToVis}}">
                    <StackPanel VerticalAlignment="Center" MaxWidth="520">
                        <TextBlock Text="{loc:Loc Welcome_Step3_Title}" Style="{StaticResource WelcomeTitle}"/>
                        <TextBlock Text="{loc:Loc Welcome_Step3_Desc}" Style="{StaticResource WelcomeSubtitle}"
                                   Margin="0,8,0,24"/>

                        <Border Style="{StaticResource SettingsCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{loc:Loc Welcome_Hotkey_Label}" Style="{StaticResource WelcomeCardLabel}"/>
                                    <TextBlock Text="{loc:Loc Welcome_Hotkey_Desc}" Style="{StaticResource WelcomeCardDesc}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                            Margin="12,0,0,0">
                                    <Button x:Name="BindCopilotButton" Content="{loc:Loc Settings_Hotkey_BindCopilot}"
                                            Click="BindCopilot_Click" Margin="0,0,10,0">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Foreground" Value="#8B7B6B"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter Property="FontSize" Value="13"/>
                                                <Setter Property="Padding" Value="2,0"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Foreground" Value="#5B4833"/>
                                                                </Trigger>
                                                                <Trigger Property="IsPressed" Value="True">
                                                                    <Setter Property="Foreground" Value="#3D3327"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Grid>
                                        <TextBox x:Name="HotkeyBox" Width="180" Style="{StaticResource SettingsInputWide}"
                                                 IsReadOnly="True" Cursor="Hand"
                                                 Text="{Binding HotkeyDisplay, Mode=OneWay}"
                                                 GotFocus="HotkeyBox_GotFocus"
                                                 LostFocus="HotkeyBox_LostFocus"
                                                 PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
                                        <TextBlock x:Name="HotkeyHint" Text="{loc:Loc Settings_Hotkey_PressPrompt}"
                                                   Foreground="#8B7B6B" FontSize="12"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                                   IsHitTestVisible="False" Visibility="Collapsed"/>
                                    </Grid>
                                    <Button Style="{StaticResource SettingsResetButton}"
                                            Command="{Binding ResetHotkeyCommand}" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Welcome_Tray_Label}" Style="{StaticResource WelcomeCardLabel}"/>
                                <TextBlock Text="{loc:Loc Welcome_Tray_Desc}" Style="{StaticResource WelcomeCardDesc}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#F2EADB" CornerRadius="10" Padding="16,12" Margin="0,4,0,0"
                                Visibility="{Binding ShowApiSkippedNote, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{loc:Loc Welcome_ApiSkipped_Note}" Foreground="#8B7B6B"
                                       FontSize="12" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- 底部按钮区 -->
            <Grid Grid.Row="2" Margin="36,0,36,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StepIndicator}" Style="{StaticResource WelcomeStepLabel}"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{Binding SecondaryButtonText}" Style="{StaticResource SecondaryActionButton}"
                            Command="{Binding SecondaryCommand}" Margin="0,0,10,0"/>
                    <Button Content="{loc:Loc Welcome_Back}" Style="{StaticResource SecondaryActionButton}"
                            Command="{Binding BackCommand}" Margin="0,0,10,0"
                            Visibility="{Binding IsStep2, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="{Binding PrimaryButtonText}" Style="{StaticResource PrimaryActionButton}"
                            Command="{Binding NextCommand}"/>
                </StackPanel>
            </Grid>
        </Grid>
</Window>

<Window x:Class="Luna.HomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:Luna.Models"
        xmlns:viewmodels="clr-namespace:Luna.ViewModels"
        xmlns:views="clr-namespace:Luna.Views"
        xmlns:md="clr-namespace:WpfMarkdownViewer.Controls;assembly=WpfMarkdownViewer"
        
        Title="Luna"
        Icon="pack://application:,,,/iconStream/Luna.ico"
        Width="1200" Height="850"
        MinWidth="720" MinHeight="550"
Background="#E4E0CA"
        WindowState="Normal"
        ResizeMode="CanResize"
        StateChanged="Window_StateChanged">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/ScrollBar.xaml"/>
                <ResourceDictionary Source="/Styles/ToastStyles.xaml"/>
                <ResourceDictionary Source="/Styles/SettingsStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        

        <Style x:Key="SideButton" TargetType="Button">
            <Setter Property="Foreground" Value="#5B4833"/>
            <Setter Property="Background" Value="#E4E0CA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="55"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F5F2E0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#EDE9D5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Background" Value="Transparent"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HistoryItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="10,0,10,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="12,8">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="TitleText"
                                           Text="{Binding Title}"
                                           Foreground="#FEFAE1"
                                           FontSize="13"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="PreviewText"
                                           Text="{Binding Preview}"
                                           Foreground="#B0A090"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3D362F"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F1E8B2"/>
                                <Setter TargetName="TitleText" Property="Foreground" Value="#5B4833"/>
                                <Setter TargetName="PreviewText" Property="Foreground" Value="#8B7B6B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧面板 -->
        <Border Grid.Column="0" CornerRadius="0,8,8,0" ClipToBounds="True" Background="#4A433D">
            <Grid Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Button x:Name="NewChatButton" Grid.Row="0"
                        Style="{StaticResource SideButton}"
                        Margin="10,10,10,8"
                        Height="56"
                        FontSize="16"
                        FontWeight="Bold"
                        Content="新对话"
                        Command="{Binding NewChatCommand}"/>

                <Grid Grid.Row="1">
                    <ListBox x:Name="HistoryList"
                             ItemsSource="{Binding ChatSessions}"
                             ItemContainerStyle="{StaticResource HistoryItemStyle}"
                             SelectedItem="{Binding SelectedSession}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.CanContentScroll="False"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>

                    <Rectangle VerticalAlignment="Bottom"
                               Height="5"
                               Fill="#4A433D"
                               IsHitTestVisible="False"/>
                </Grid>

                <StackPanel Grid.Row="2" Margin="10,0,10,10">
                    <!-- <Rectangle Height="1" Fill="#E4E0CA" Margin="0,0,0,8"/> -->
                    <Button x:Name="DiaryButton" Style="{StaticResource SideButton}" Content="日记本" Margin="0,0,0,5"/>
                    <Button x:Name="ToolsButton" Style="{StaticResource SideButton}" Content="工具" Margin="0,0,0,5"/>
                    <Button x:Name="SettingsButton" Style="{StaticResource SideButton}" Content="设置"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 分割线 -->
        <Rectangle Grid.Column="1" Width="1" Fill="#E4E0CA" HorizontalAlignment="Left"/>

        <!-- 右侧聊天区 -->
        <Grid Grid.Column="2" Background="#E4E0CA">
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 顶部标题区：可拖拽 + 双击最大化 -->
            <Grid x:Name="HeaderDragArea" Grid.Row="0" Background="Transparent"
                  MouseLeftButtonDown="HeaderArea_MouseDown"
                  MouseMove="HeaderArea_MouseMove"
                  MouseUp="HeaderArea_MouseUp">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="ChatTitle"
                           Grid.Column="0"
                           Text="新聊天"
                           Foreground="#5B4833"
                           FontSize="16"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="20,0,0,0"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="MinButton" Width="36" Height="30" Background="Transparent"
                            BorderThickness="0" Foreground="#5B4833" FontSize="12"
                            Content="─" Click="MinButton_Click" Cursor="Hand"/>
                    <Button x:Name="MaxButton" Width="36" Height="30" Background="Transparent"
                            BorderThickness="0" Foreground="#5B4833" FontSize="11"
                            Content="□" Click="MaxButton_Click" Cursor="Hand"/>
                    <Button x:Name="CloseButton" Width="36" Height="30" Background="Transparent"
                            BorderThickness="0" Foreground="#5B4833" FontSize="12"
                            Content="✕" Click="CloseButton_Click" Cursor="Hand"/>
                </StackPanel>
            </Grid>

            <!-- 分割线 -->
            <Rectangle Grid.Row="0" Height="1" Fill="#E4E0CA" VerticalAlignment="Bottom"/>

            <!-- 消息列表 -->
            <Grid Grid.Row="1">
                <ScrollViewer x:Name="MessageScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.CanContentScroll="False"
                              PreviewMouseWheel="SmoothScroll_PreviewMouseWheel"
                              Padding="20,16">
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="models:ChatMessage">
                            <Border MaxWidth="600"
                                    CornerRadius="8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,0,4"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Role}" Value="user">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="Background" Value="#78ACAD"/>
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Margin" Value="0,0,10,16"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
<Grid>
                                <!-- 用户消息：纯文本 -->
                                <TextBox Text="{Binding Content}"
                                            TextWrapping="Wrap"
                                            Foreground="#FEFAE1"
                                            FontSize="15"
                                            HorizontalAlignment="Left"
                                            Margin="10,6"
                                            IsReadOnly="True"
                                            BorderThickness="0"
                                            Background="Transparent"
                                            IsInactiveSelectionHighlightEnabled="True"
                                            Loaded="MessageText_Loaded">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Role}" Value="user">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
<!-- AI 消息：Markdown 阅读器 + 思考指示 -->
<StackPanel>
                                        <StackPanel Margin="10,6,10,0">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Role}" Value="assistant">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>

                                                    <!-- 无推理内容时：动画 "正在思考..." -->
                                                    <StackPanel Orientation="Horizontal"
                                                                IsHitTestVisible="False">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasReasoning}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsThinking}" Value="False">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <TextBlock Text="正在思考" Foreground="#8B7B6B" FontSize="15" FontStyle="Italic" VerticalAlignment="Center"/>
                                                        <TextBlock Text="." Foreground="#8B7B6B" FontSize="15" VerticalAlignment="Center" Margin="1,0,0,0">
                                                            <TextBlock.Triggers>
                                                                <EventTrigger RoutedEvent="Loaded">
                                                                    <BeginStoryboard>
                                                                        <Storyboard RepeatBehavior="Forever">
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.2" To="1" Duration="0:0:0.6" AutoReverse="True" BeginTime="0:0:0.0"/>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </EventTrigger>
                                                            </TextBlock.Triggers>
                                                        </TextBlock>
                                                        <TextBlock Text="." Foreground="#8B7B6B" FontSize="15" VerticalAlignment="Center" Margin="0">
                                                            <TextBlock.Triggers>
                                                                <EventTrigger RoutedEvent="Loaded">
                                                                    <BeginStoryboard>
                                                                        <Storyboard RepeatBehavior="Forever">
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.2" To="1" Duration="0:0:0.6" AutoReverse="True" BeginTime="0:0:0.2"/>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </EventTrigger>
                                                            </TextBlock.Triggers>
                                                        </TextBlock>
                                                        <TextBlock Text="." Foreground="#8B7B6B" FontSize="15" VerticalAlignment="Center" Margin="0">
                                                            <TextBlock.Triggers>
                                                                <EventTrigger RoutedEvent="Loaded">
                                                                    <BeginStoryboard>
                                                                        <Storyboard RepeatBehavior="Forever">
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.2" To="1" Duration="0:0:0.6" AutoReverse="True" BeginTime="0:0:0.4"/>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </EventTrigger>
                                                            </TextBlock.Triggers>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <!-- 有推理内容时：可折叠思考过程 -->
                                                    <StackPanel>
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasReasoning}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <ToggleButton IsChecked="{Binding IsReasoningExpanded, Mode=TwoWay}"
                                                                      HorizontalAlignment="Left" Cursor="Hand"
                                                                      Background="Transparent" BorderThickness="0"
                                                                      Padding="0" Margin="0,0,0,4">
                                                            <ToggleButton.Template>
                                                                <ControlTemplate TargetType="ToggleButton">
                                                                    <Border Background="Transparent" Padding="8,4">
                                                                        <ContentPresenter/>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </ToggleButton.Template>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="思考过程" Foreground="#8B7B6B" FontSize="13" FontStyle="Italic" VerticalAlignment="Center"/>
                                                                <TextBlock Text="▸" Foreground="#8B7B6B" FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsReasoningExpanded}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock Text="▾" Foreground="#8B7B6B" FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsReasoningExpanded}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </ToggleButton>
                                                        <!-- 用户收起但仍在思考中 -->
                                                        <StackPanel Orientation="Horizontal"
                                                                    IsHitTestVisible="False" Margin="0,0,0,4">
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding HasReasoning}" Value="True"/>
                                                                                <Condition Binding="{Binding IsReasoningExpanded}" Value="False"/>
                                                                                <Condition Binding="{Binding IsThinking}" Value="True"/>
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>
                                                            <TextBlock Text="正在思考" Foreground="#8B7B6B" FontSize="13" FontStyle="Italic" VerticalAlignment="Center"/>
                                                            <TextBlock Text="." Foreground="#8B7B6B" FontSize="13" VerticalAlignment="Center" Margin="1,0,0,0">
                                                                <TextBlock.Triggers>
                                                                    <EventTrigger RoutedEvent="Loaded">
                                                                        <BeginStoryboard>
                                                                            <Storyboard RepeatBehavior="Forever">
                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.2" To="1" Duration="0:0:0.6" AutoReverse="True" BeginTime="0:0:0.0"/>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </EventTrigger>
                                                                </TextBlock.Triggers>
                                                            </TextBlock>
                                                            <TextBlock Text="." Foreground="#8B7B6B" FontSize="13" VerticalAlignment="Center" Margin="0">
                                                                <TextBlock.Triggers>
                                                                    <EventTrigger RoutedEvent="Loaded">
                                                                        <BeginStoryboard>
                                                                            <Storyboard RepeatBehavior="Forever">
                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.2" To="1" Duration="0:0:0.6" AutoReverse="True" BeginTime="0:0:0.2"/>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </EventTrigger>
                                                                </TextBlock.Triggers>
                                                            </TextBlock>
                                                            <TextBlock Text="." Foreground="#8B7B6B" FontSize="13" VerticalAlignment="Center" Margin="0">
                                                                <TextBlock.Triggers>
                                                                    <EventTrigger RoutedEvent="Loaded">
                                                                        <BeginStoryboard>
                                                                            <Storyboard RepeatBehavior="Forever">
                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.2" To="1" Duration="0:0:0.6" AutoReverse="True" BeginTime="0:0:0.4"/>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </EventTrigger>
                                                                </TextBlock.Triggers>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto"
                                                                      Loaded="ReasoningScrollViewer_Loaded"
                                                                      Visibility="{Binding IsReasoningExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="{Binding Reasoning}" TextWrapping="Wrap"
                                                                       Foreground="#8B7B6B" FontSize="13"
                                                                       IsHitTestVisible="False" Focusable="False"/>
                                                        </ScrollViewer>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- 工具调用卡片 -->
                                                <ItemsControl ItemsSource="{Binding ToolCalls}" Margin="10,4,10,0">
                                                    <ItemsControl.Style>
                                                        <Style TargetType="ItemsControl">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding HasToolCalls}" Value="True"/>
                                                                        <Condition Binding="{Binding Role}" Value="assistant"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ItemsControl.Style>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type models:ToolCallEntry}">
                                                            <StackPanel Margin="0,0,0,0">
                                                                <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                                              HorizontalAlignment="Left" Cursor="Hand"
                                                                              Background="Transparent" BorderThickness="0"
                                                                              Padding="0">
                                                                    <ToggleButton.Template>
                                                                        <ControlTemplate TargetType="ToggleButton">
                                                                            <Border Background="Transparent" Padding="8,4">
                                                                                <ContentPresenter/>
                                                                            </Border>
                                                                        </ControlTemplate>
                                                                    </ToggleButton.Template>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Foreground="#8B7B6B" FontSize="10" VerticalAlignment="Center">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding Status}" Value="Pending">  <Setter Property="Text" Value="⏳"/></DataTrigger>
                                                                                        <DataTrigger Binding="{Binding Status}" Value="Running"> <Setter Property="Text" Value="⏳"/></DataTrigger>
                                                                                        <DataTrigger Binding="{Binding Status}" Value="Success"> <Setter Property="Text" Value="✓"/></DataTrigger>
                                                                                        <DataTrigger Binding="{Binding Status}" Value="Failed">  <Setter Property="Text" Value="✗"/></DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                        <TextBlock Text="{Binding DisplayName}" Foreground="#8B7B6B" FontSize="13" FontStyle="Italic" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                                        <TextBlock Text="▸" Foreground="#8B7B6B" FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                        <TextBlock Text="▾" Foreground="#8B7B6B" FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                </ToggleButton>
                                                                <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                        Margin="0,4,0,0">
                                                                            <TextBlock Text="参数" Foreground="#8B7B6B" FontSize="11" FontStyle="Italic" Margin="8,0,0,2"/>
                                                                            <ScrollViewer MaxHeight="90" VerticalScrollBarVisibility="Auto" Margin="0,0,0,6">
                                                                                <TextBlock Text="{Binding ArgumentsJson}" Foreground="#8B7B6B" FontSize="11"
                                                                                           FontFamily="Consolas" TextWrapping="Wrap" Margin="8,0,0,0"/>
                                                                            </ScrollViewer>
                                                                            <TextBlock Text="结果" Foreground="#8B7B6B" FontSize="11" FontStyle="Italic" Margin="8,0,0,2"/>
                                                                            <ScrollViewer MaxHeight="90" VerticalScrollBarVisibility="Auto">
                                                                                <TextBlock Text="{Binding ResultJson}" Foreground="#5B4833" FontSize="13"
                                                                                           TextWrapping="Wrap" Margin="8,0,0,0"/>
                                                                            </ScrollViewer>
                                                                        </StackPanel>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                            <md:MarkdownDocumentView SelectionEnabled="True"
                                                                              Background="Transparent"
                                                                              HorizontalAlignment="Left"
                                                                              VirtualizationEnabled="False"
                                                                              MaxWidth="600"
                                                                              Margin="0,0"
                                                                              Loaded="MessageViewer_Loaded"
                                                                              PreviewMouseWheel="MarkdownViewer_PreviewMouseWheel">
                                                    <md:MarkdownDocumentView.Style>
                                                        <Style TargetType="md:MarkdownDocumentView">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding Role}" Value="assistant"/>
                                                                        <Condition Binding="{Binding HasContent}" Value="True"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </md:MarkdownDocumentView.Style>
                                                </md:MarkdownDocumentView>
                                        <!-- 出错 / 取消提示 -->
                                        <Border Margin="10,4,10,0" Padding="10,7" CornerRadius="6"
                                                Background="#22FD7956"
                                                HorizontalAlignment="Left"
                                                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="{Binding ErrorMessage}" Foreground="#A93226"
                                                       FontSize="13" TextWrapping="Wrap" MaxWidth="560"/>
                                        </Border>
                                        <!-- AI 操作按钮 -->
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Left"
                                                    Margin="10,0,0,4">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding Role}" Value="assistant"/>
                                                                <Condition Binding="{Binding IsFinalReply}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Button Content="复制" FontSize="12" Height="26" Width="50"
                                                    Cursor="Hand" BorderThickness="0" Foreground="#5B4833"
                                                    Background="#D4D0BA" Margin="0,0,6,0"
                                                    Click="CopyMessage_Click"/>
                                            <Button Content="重写" FontSize="12" Height="26" Width="50"
                                                    Cursor="Hand" BorderThickness="0" Foreground="#5B4833"
                                                    Background="#D4D0BA"
                                                    Click="RewriteMessage_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                            </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            </Grid>

            <!-- 设置 内容区 -->
            <Grid x:Name="SettingsContent" Grid.Row="1" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              PreviewMouseWheel="SmoothScroll_PreviewMouseWheel"
                              Padding="20,16">
                    <StackPanel>
                        <!-- 通用 -->
                        <TextBlock Text="通用" Foreground="#5B4833" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                        <views:GeneralSettingsView x:Name="GeneralSettingsPanel"/>

                        <!-- 聊天 -->
                        <TextBlock Text="聊天" Foreground="#5B4833" FontSize="18" FontWeight="Bold" Margin="0,12,0,12"/>
                        <views:AiConnectionView x:Name="AiConnectionPanel"/>

                        <!-- 调试 -->
                        <TextBlock Text="调试" Foreground="#5B4833" FontSize="18" FontWeight="Bold" Margin="0,12,0,12"/>
                        <Button x:Name="OpenLogsButton"
                                Content="打开日志文件夹"
                                Click="OpenLogsButton_Click"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,8">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Foreground" Value="#5B4833"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Height" Value="34"/>
                                    <Setter Property="Padding" Value="20,0"/>
                                    <Setter Property="Background" Value="#D4D0BA"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bg" CornerRadius="8" Padding="{TemplateBinding Padding}"
                                                        Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#DDD9C5"/></Trigger>
                                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bg" Property="Background" Value="#C9C5AF"/></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button x:Name="ClearDatabaseButton"
                                Content="清空数据库文件"
                                Click="ClearDatabaseButton_Click"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,8">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Height" Value="34"/>
                                    <Setter Property="Padding" Value="20,0"/>
                                    <Setter Property="Background" Value="#FD7956"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bg" CornerRadius="8" Padding="{TemplateBinding Padding}"
                                                        Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#D64541"/></Trigger>
                                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bg" Property="Background" Value="#A93226"/></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <Grid x:Name="DiaryContent" Grid.Row="1" Visibility="Collapsed">
                <TextBlock Text="日记本页面"
                           Foreground="#8B7B6B"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>
            <Grid x:Name="ToolsContent" Grid.Row="1" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              PreviewMouseWheel="SmoothScroll_PreviewMouseWheel"
                              Padding="20,16">
                    <ItemsControl ItemsSource="{Binding ToolCategories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:ToolCategory}">
                                <StackPanel Margin="0,0,0,24">
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="#5B4833" FontSize="15" FontWeight="Bold"
                                               Margin="0,0,0,10"/>

                                    <ItemsControl ItemsSource="{Binding Tools}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:ToolDefinition}">
                                                <Border Style="{StaticResource SettingsCard}"
                                                        Padding="14,12" Margin="0,0,0,8">
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="{Binding Name}" Style="{StaticResource SettingsTitle}"/>
<TextBlock Text="{Binding Description}" Style="{StaticResource SettingsDesc}" Margin="0"/>
                                                                <TextBlock Text="{Binding StatusText}"
                                                                           Foreground="#CB8B5B" FontSize="12"
                                                                           Margin="0,2,0,0"
                                                                           Visibility="{Binding HasStatusText, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding RiskLabel}"
                                                                           Foreground="{Binding RiskBrush}"
                                                                           FontSize="14" FontWeight="SemiBold"
                                                                           VerticalAlignment="Center"
                                                                           Margin="0,0,8,0"
                                                                           Visibility="{Binding HasRiskLabel, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                <CheckBox Style="{StaticResource SettingsToggle}"
                                                                          IsChecked="{Binding IsEnabled}"
                                                                          IsEnabled="{Binding IsAvailable}"
                                                                          VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- web_search 的 Tavily Key 子控件 -->
                                                        <Grid Margin="0,10,0,0">
                                                            <Grid.Style>
                                                                <Style TargetType="Grid">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Id}" Value="web_search">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Grid.Style>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="Tavily API Key"
                                                                       Style="{StaticResource SettingsTitle}"
                                                                       VerticalAlignment="Center"/>
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <PasswordBox Width="180" Style="{StaticResource SettingsPassword}"
                                                                             Loaded="TavilyKeyBox_Loaded"
                                                                             PasswordChanged="TavilyKeyBox_PasswordChanged"
                                                                             VerticalAlignment="Center"/>
                                                                <Button Style="{StaticResource SettingsResetButton}"
                                                                        Click="TavilyKeyReset_Click" Margin="6,0,0,0"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- 输入区 -->
            <Grid Grid.Row="2" x:Name="InputArea" Margin="20,0,20,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="#CC372F29"
                        CornerRadius="10"
                        Padding="12,8"
                        Margin="0,0,8,0">
                    <TextBox x:Name="InputBox"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             MaxHeight="80"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Center"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="#FEFAE1"
                             CaretBrush="#FEFAE1"
                             FontSize="14"
                             Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                             PreviewKeyDown="InputBox_KeyDown"/>
                </Border>

                <Button Grid.Column="1"
                        Content="发送"
                        Command="{Binding SendCommand}"
                        Width="64" Height="36"
                        Background="#85B2AF"
                        Foreground="#FEFAE1"
                        BorderThickness="0"
                        Cursor="Hand"
                        VerticalAlignment="Bottom"
                        FontSize="13">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8" Padding="12,0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#96C2BF"/></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bg" Property="Background" Value="#78A29F"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Grid.Column="1"
                        Content="取消"
                        Background="#FD7956"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Command="{Binding CancelCommand}"
                        Width="64" Height="36"
                        VerticalAlignment="Bottom"
                        FontSize="13"
                        Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8" Padding="12,0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#D64541"/></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bg" Property="Background" Value="#A93226"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <TextBlock x:Name="StatusText" Grid.Row="3"
                       Text="{Binding Status}"
                       Foreground="#5B4833"
                       FontSize="12"
                       Margin="24,0,0,12"/>
        </Grid>

    <!-- 通知浮层 -->
    <Grid x:Name="ToastLayer"
          Grid.ColumnSpan="3"
          IsHitTestVisible="True"
          Visibility="Visible">
        <StackPanel x:Name="ToastStack"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,16,16"/>
    </Grid>
</Grid>
</Window>
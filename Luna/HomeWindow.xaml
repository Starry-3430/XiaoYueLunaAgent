<Window x:Class="Luna.HomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:Luna.Models"
        xmlns:viewmodels="clr-namespace:Luna.ViewModels"
        xmlns:md="clr-namespace:WpfMarkdownViewer.Controls;assembly=WpfMarkdownViewer"
        
        Title="Luna"
        Width="1200" Height="850"
        MinWidth="720" MinHeight="550"
Background="#E4E0CA"
        WindowState="Normal"
        ResizeMode="CanResize"
        StateChanged="Window_StateChanged">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/ScrollBar.xaml"/>
                <ResourceDictionary Source="/Styles/ToastStyles.xaml"/>
                <ResourceDictionary Source="/Styles/SettingsStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        

        <Style x:Key="SideButton" TargetType="Button">
            <Setter Property="Foreground" Value="#5B4833"/>
            <Setter Property="Background" Value="#E4E0CA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="55"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F5F2E0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#EDE9D5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Background" Value="Transparent"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HistoryItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="10,0,10,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="12,8">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="TitleText"
                                           Text="{Binding Title}"
                                           Foreground="#FEFAE1"
                                           FontSize="13"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="PreviewText"
                                           Text="{Binding Preview}"
                                           Foreground="#B0A090"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3D362F"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F1E8B2"/>
                                <Setter TargetName="TitleText" Property="Foreground" Value="#5B4833"/>
                                <Setter TargetName="PreviewText" Property="Foreground" Value="#8B7B6B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧面板 -->
        <Border Grid.Column="0" CornerRadius="0,8,8,0" ClipToBounds="True" Background="#4A433D">
            <Grid Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Button x:Name="NewChatButton" Grid.Row="0"
                        Style="{StaticResource SideButton}"
                        Margin="10,10,10,8"
                        Height="56"
                        FontSize="16"
                        FontWeight="Bold"
                        Content="新对话"
                        Command="{Binding NewChatCommand}"/>

                <Grid Grid.Row="1">
                    <ListBox x:Name="HistoryList"
                             ItemsSource="{Binding ChatSessions}"
                             ItemContainerStyle="{StaticResource HistoryItemStyle}"
                             SelectedItem="{Binding SelectedSession}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.CanContentScroll="False"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>

                    <Rectangle VerticalAlignment="Bottom"
                               Height="5"
                               Fill="#4A433D"
                               IsHitTestVisible="False"/>
                </Grid>

                <StackPanel Grid.Row="2" Margin="10,0,10,10">
                    <!-- <Rectangle Height="1" Fill="#E4E0CA" Margin="0,0,0,8"/> -->
                    <Button x:Name="DiaryButton" Style="{StaticResource SideButton}" Content="日记本" Margin="0,0,0,5"/>
                    <Button x:Name="ToolsButton" Style="{StaticResource SideButton}" Content="工具" Margin="0,0,0,5"/>
                    <Button x:Name="SettingsButton" Style="{StaticResource SideButton}" Content="设置"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 分割线 -->
        <Rectangle Grid.Column="1" Width="1" Fill="#E4E0CA" HorizontalAlignment="Left"/>

        <!-- 右侧聊天区 -->
        <Grid Grid.Column="2" Background="#E4E0CA">
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 顶部标题区：可拖拽 + 双击最大化 -->
            <Grid x:Name="HeaderDragArea" Grid.Row="0" Background="Transparent"
                  MouseLeftButtonDown="HeaderArea_MouseDown"
                  MouseMove="HeaderArea_MouseMove"
                  MouseUp="HeaderArea_MouseUp">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="ChatTitle"
                           Grid.Column="0"
                           Text="新聊天"
                           Foreground="#5B4833"
                           FontSize="16"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="20,0,0,0"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="MinButton" Width="36" Height="30" Background="Transparent"
                            BorderThickness="0" Foreground="#5B4833" FontSize="12"
                            Content="─" Click="MinButton_Click" Cursor="Hand"/>
                    <Button x:Name="MaxButton" Width="36" Height="30" Background="Transparent"
                            BorderThickness="0" Foreground="#5B4833" FontSize="11"
                            Content="□" Click="MaxButton_Click" Cursor="Hand"/>
                    <Button x:Name="CloseButton" Width="36" Height="30" Background="Transparent"
                            BorderThickness="0" Foreground="#5B4833" FontSize="12"
                            Content="✕" Click="CloseButton_Click" Cursor="Hand"/>
                </StackPanel>
            </Grid>

            <!-- 分割线 -->
            <Rectangle Grid.Row="0" Height="1" Fill="#E4E0CA" VerticalAlignment="Bottom"/>

            <!-- 消息列表 -->
            <Grid Grid.Row="1">
                <ScrollViewer x:Name="MessageScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.CanContentScroll="False"
                              Padding="20,16">
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="models:ChatMessage">
                            <Border MaxWidth="600"
                                    CornerRadius="8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,0,16"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Role}" Value="user">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="Background" Value="#78ACAD"/>
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Margin" Value="0,0,10,16"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
<Grid>
                                <!-- 用户消息：纯文本 -->
                                <TextBox Text="{Binding Content}"
                                            TextWrapping="Wrap"
                                            Foreground="#FEFAE1"
                                            FontSize="15"
                                            HorizontalAlignment="Left"
                                            Margin="10,6"
                                            IsReadOnly="True"
                                            BorderThickness="0"
                                            Background="Transparent"
                                            IsInactiveSelectionHighlightEnabled="True"
                                            Loaded="MessageText_Loaded">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Role}" Value="user">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
<!-- AI 消息：Markdown 阅读器 + 思考指示 -->
<StackPanel>
                                        <StackPanel Margin="10,6,10,0">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Role}" Value="assistant">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>

                                                    <!-- 无推理内容时：动画 "正在思考..." -->
                                                    <StackPanel Orientation="Horizontal"
                                                                IsHitTestVisible="False">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasReasoning}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsThinking}" Value="False">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <TextBlock Text="正在思考" Foreground="#8B7B6B" FontSize="15" FontStyle="Italic" VerticalAlignment="Center"/>
                                                        <TextBlock Text="." Foreground="#8B7B6B" FontSize="15" VerticalAlignment="Center" Margin="1,0,0,0">
                                                            <TextBlock.Triggers>
                                                                <EventTrigger RoutedEvent="Loaded">
                                                                    <BeginStoryboard>
                                                                        <Storyboard RepeatBehavior="Forever">
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.2" To="1" Duration="0:0:0.6" AutoReverse="True" BeginTime="0:0:0.0"/>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </EventTrigger>
                                                            </TextBlock.Triggers>
                                                        </TextBlock>
                                                        <TextBlock Text="." Foreground="#8B7B6B" FontSize="15" VerticalAlignment="Center" Margin="0">
                                                            <TextBlock.Triggers>
                                                                <EventTrigger RoutedEvent="Loaded">
                                                                    <BeginStoryboard>
                                                                        <Storyboard RepeatBehavior="Forever">
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.2" To="1" Duration="0:0:0.6" AutoReverse="True" BeginTime="0:0:0.2"/>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </EventTrigger>
                                                            </TextBlock.Triggers>
                                                        </TextBlock>
                                                        <TextBlock Text="." Foreground="#8B7B6B" FontSize="15" VerticalAlignment="Center" Margin="0">
                                                            <TextBlock.Triggers>
                                                                <EventTrigger RoutedEvent="Loaded">
                                                                    <BeginStoryboard>
                                                                        <Storyboard RepeatBehavior="Forever">
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.2" To="1" Duration="0:0:0.6" AutoReverse="True" BeginTime="0:0:0.4"/>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </EventTrigger>
                                                            </TextBlock.Triggers>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <!-- 有推理内容时：可折叠思考过程 -->
                                                    <StackPanel>
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasReasoning}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <ToggleButton IsChecked="{Binding IsReasoningExpanded, Mode=TwoWay}"
                                                                      HorizontalAlignment="Left" Cursor="Hand"
                                                                      Background="Transparent" BorderThickness="0"
                                                                      Padding="0" Margin="0,0,0,4">
                                                            <ToggleButton.Template>
                                                                <ControlTemplate TargetType="ToggleButton">
                                                                    <Border Background="Transparent" Padding="8,4">
                                                                        <ContentPresenter/>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </ToggleButton.Template>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="思考过程" Foreground="#8B7B6B" FontSize="13" FontStyle="Italic" VerticalAlignment="Center"/>
                                                                <TextBlock Text="▸" Foreground="#8B7B6B" FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsReasoningExpanded}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock Text="▾" Foreground="#8B7B6B" FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsReasoningExpanded}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </ToggleButton>
                                                        <!-- 用户收起但仍在思考中 -->
                                                        <StackPanel Orientation="Horizontal"
                                                                    IsHitTestVisible="False" Margin="0,0,0,4">
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding HasReasoning}" Value="True"/>
                                                                                <Condition Binding="{Binding IsReasoningExpanded}" Value="False"/>
                                                                                <Condition Binding="{Binding IsThinking}" Value="True"/>
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>
                                                            <TextBlock Text="正在思考" Foreground="#8B7B6B" FontSize="13" FontStyle="Italic" VerticalAlignment="Center"/>
                                                            <TextBlock Text="." Foreground="#8B7B6B" FontSize="13" VerticalAlignment="Center" Margin="1,0,0,0">
                                                                <TextBlock.Triggers>
                                                                    <EventTrigger RoutedEvent="Loaded">
                                                                        <BeginStoryboard>
                                                                            <Storyboard RepeatBehavior="Forever">
                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.2" To="1" Duration="0:0:0.6" AutoReverse="True" BeginTime="0:0:0.0"/>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </EventTrigger>
                                                                </TextBlock.Triggers>
                                                            </TextBlock>
                                                            <TextBlock Text="." Foreground="#8B7B6B" FontSize="13" VerticalAlignment="Center" Margin="0">
                                                                <TextBlock.Triggers>
                                                                    <EventTrigger RoutedEvent="Loaded">
                                                                        <BeginStoryboard>
                                                                            <Storyboard RepeatBehavior="Forever">
                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.2" To="1" Duration="0:0:0.6" AutoReverse="True" BeginTime="0:0:0.2"/>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </EventTrigger>
                                                                </TextBlock.Triggers>
                                                            </TextBlock>
                                                            <TextBlock Text="." Foreground="#8B7B6B" FontSize="13" VerticalAlignment="Center" Margin="0">
                                                                <TextBlock.Triggers>
                                                                    <EventTrigger RoutedEvent="Loaded">
                                                                        <BeginStoryboard>
                                                                            <Storyboard RepeatBehavior="Forever">
                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.2" To="1" Duration="0:0:0.6" AutoReverse="True" BeginTime="0:0:0.4"/>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </EventTrigger>
                                                                </TextBlock.Triggers>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto"
                                                                      Loaded="ReasoningScrollViewer_Loaded"
                                                                      Visibility="{Binding IsReasoningExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="{Binding Reasoning}" TextWrapping="Wrap"
                                                                       Foreground="#8B7B6B" FontSize="13"
                                                                       IsHitTestVisible="False" Focusable="False"/>
                                                        </ScrollViewer>
                                                    </StackPanel>
                                                </StackPanel>
<md:MarkdownDocumentView SelectionEnabled="True"
                                                                              Background="Transparent"
                                                                              HorizontalAlignment="Left"
                                                                              VirtualizationEnabled="False"
                                                                              MaxWidth="600"
                                                                              Margin="0,6"
                                                                              Loaded="MessageViewer_Loaded"
                                                                              PreviewMouseWheel="MarkdownViewer_PreviewMouseWheel">
                                                    <md:MarkdownDocumentView.Style>
                                                        <Style TargetType="md:MarkdownDocumentView">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Role}" Value="assistant">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </md:MarkdownDocumentView.Style>
                                                </md:MarkdownDocumentView>
                                        <!-- AI 操作按钮 -->
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Left"
                                                    Margin="10,0,0,4">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Role}" Value="assistant">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsStreaming}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Button Content="复制" FontSize="12" Height="26" Width="50"
                                                    Cursor="Hand" BorderThickness="0" Foreground="#5B4833"
                                                    Background="#D4D0BA" Margin="0,0,6,0"
                                                    Click="CopyMessage_Click"/>
                                            <Button Content="重写" FontSize="12" Height="26" Width="50"
                                                    Cursor="Hand" BorderThickness="0" Foreground="#5B4833"
                                                    Background="#D4D0BA"
                                                    Click="RewriteMessage_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                            </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            </Grid>

            <!-- 设置 / 日记本 / 工具 内容区 -->
            <Grid x:Name="SettingsContent" Grid.Row="1" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="20,16">
                    <ItemsControl ItemsSource="{Binding SettingsItems}">
                        <ItemsControl.Resources>
                            <DataTemplate DataType="{x:Type models:ToggleSetting}">
                                <Border Style="{StaticResource SettingsCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource SettingsTitle}"/>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource SettingsDesc}" Margin="0"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Style="{StaticResource SettingsToggle}"
                                                  IsChecked="{Binding Value}" VerticalAlignment="Top"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>

                            <DataTemplate DataType="{x:Type models:NumberSetting}">
                                <Border Style="{StaticResource SettingsCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource SettingsTitle}"/>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource SettingsDesc}" Margin="0"/>
                                        </StackPanel>
                                        <Grid Grid.Column="1" VerticalAlignment="Top" Margin="12,0,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="−" Style="{StaticResource SettingsStepperButton}" Command="{Binding DecrementCommand}"/>
                                            <TextBox Grid.Column="1" Text="{Binding DisplayText, UpdateSourceTrigger=LostFocus}"
                                                     Style="{StaticResource SettingsInput}" Margin="6,0"
                                                     PreviewKeyDown="NumberInput_KeyDown"/>
                                            <Button Grid.Column="2" Content="+" Style="{StaticResource SettingsStepperButton}" Command="{Binding IncrementCommand}" Margin="0,0,6,0"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Unit}" Foreground="#88FFFFFF" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <Button Grid.Column="4" Style="{StaticResource SettingsResetButton}" Command="{Binding ResetCommand}"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>

                            <DataTemplate DataType="{x:Type models:SelectSetting}">
                                <Border Style="{StaticResource SettingsCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource SettingsTitle}"/>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource SettingsDesc}" Margin="0"/>
                                        </StackPanel>
                                        <Grid Grid.Column="1" VerticalAlignment="Top" Margin="12,0,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
<Grid Grid.Column="0">
<Border Width="250" Height="34"
                                                         Background="#D4D0BA" CornerRadius="6" Padding="10,0" Cursor="Hand"
                                                         PreviewMouseLeftButtonDown="SelectToggle_Click"
                                                         Tag="{Binding .}">
                                                    <TextBlock Text="{Binding SelectedLabel}" Foreground="#5B4833"
                                                               FontSize="13" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Border>
                                                <Popup IsOpen="{Binding IsOpen}"
                                                       Placement="Bottom" StaysOpen="True"
                                                       AllowsTransparency="True">
                                                    <Border Background="#FFFFFF" CornerRadius="10" Padding="5" MaxWidth="350">
                                                        <ItemsControl ItemsSource="{Binding Options}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate DataType="{x:Type models:SelectOption}">
                                                                    <Border Padding="10,8" CornerRadius="6" Cursor="Hand"
                                                                            Background="Transparent"
                                                                            PreviewMouseLeftButtonDown="SelectOption_Click"
                                                                            Tag="{Binding .}">
<TextBlock Text="{Binding Label}" Foreground="#5B4833"
                                                                           FontSize="13" TextWrapping="Wrap"/>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Border>
                                                </Popup>
                                            </Grid>
                                            <Button Grid.Column="1" Style="{StaticResource SettingsResetButton}" Command="{Binding ResetCommand}" Margin="4,0,0,0"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.Resources>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
            <Grid x:Name="DiaryContent" Grid.Row="1" Visibility="Collapsed">
                <TextBlock Text="日记本页面"
                           Foreground="#8B7B6B"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>
            <Grid x:Name="ToolsContent" Grid.Row="1" Visibility="Collapsed">
                <TextBlock Text="工具页面"
                           Foreground="#8B7B6B"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- 输入区 -->
            <Grid Grid.Row="2" x:Name="InputArea" Margin="20,0,20,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="#CC372F29"
                        CornerRadius="10"
                        Padding="12,8"
                        Margin="0,0,8,0">
                    <TextBox x:Name="InputBox"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             MaxHeight="80"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Center"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="#FEFAE1"
                             CaretBrush="#FEFAE1"
                             FontSize="14"
                             Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                             PreviewKeyDown="InputBox_KeyDown"/>
                </Border>

                <Button Grid.Column="1"
                        Content="发送"
                        Command="{Binding SendCommand}"
                        Width="64" Height="36"
                        Background="#85B2AF"
                        Foreground="#FEFAE1"
                        BorderThickness="0"
                        Cursor="Hand"
                        VerticalAlignment="Bottom"
                        FontSize="13">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8" Padding="12,0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#96C2BF"/></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bg" Property="Background" Value="#78A29F"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Grid.Column="1"
                        Content="取消"
                        Background="#FD7956"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Command="{Binding CancelCommand}"
                        Width="64" Height="36"
                        VerticalAlignment="Bottom"
                        FontSize="13"
                        Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8" Padding="12,0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#D64541"/></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bg" Property="Background" Value="#A93226"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <TextBlock x:Name="StatusText" Grid.Row="3"
                       Text="{Binding Status}"
                       Foreground="#5B4833"
                       FontSize="12"
                       Margin="24,0,0,12"/>
        </Grid>

    <!-- 通知浮层 -->
    <Grid x:Name="ToastLayer"
          Grid.ColumnSpan="3"
          IsHitTestVisible="True"
          Visibility="Visible">
        <StackPanel x:Name="ToastStack"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,16,16"/>
    </Grid>
</Grid>
</Window>